# ==============================================================================
# PADE STORE MENU V2 (.env.example)
# Scope: Production / Preview / Development
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ==============================================================================

# Node Environment
NODE_ENV=production

# PostgreSQL (Pooled connection string for PgBouncer / Neon Serverless)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Direct PostgreSQL URL (Optional, for direct non-pooled queries)
DIRECT_DATABASE_URL=

# Redis (Upstash REST or standard Redis URI)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=assets
R2_PUBLIC_BASE_URL=https://assets.sorae.tokyo

# Public App Base URL
NEXT_PUBLIC_MENU_BASE_URL=https://menu.sorae.tokyo

# Discord OAuth2 Configuration
# Discord App Client ID (Public snowflake string)
DISCORD_CLIENT_ID=1559780431161729166
# Discord App Client Secret (Server-only secret)
DISCORD_CLIENT_SECRET=
# Exact OAuth Callback Redirect URI
DISCORD_OAUTH_REDIRECT_URI=https://menu.sorae.tokyo/api/auth/discord/callback

# Session Secret (Minimum 32 random characters for session cookie encryption / HMAC)
SESSION_SECRET=

# Virtual Owner Discord ID (Strictly 17-20 digit snowflake string)
PADE_OWNER_DISCORD_ID=386528085681635328

# Internal Signed API Secrets (§S10)
MENU_INTERNAL_API_SECRET=
MENU_INTERNAL_API_SECRET_PREVIOUS=

# Realtime Live Sync Mode ('poll' | 'push' | 'off')
MENU_LIVE_SYNC=poll

# Error Tracking (Optional)
SENTRY_DSN=
