  <script>
    // ── BRAND UTILITIES & PARSERS ──
    function formatBrandMoney(amountMinor) {
      if (amountMinor === null || amountMinor === undefined || amountMinor === '') return '';
      let val = 0;
      if (typeof amountMinor === 'number') val = Math.max(0, Math.round(amountMinor));
      else val = Math.max(0, parseInt(amountMinor, 10) || 0);
      return val.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ' ₫';
    }

    function foldVietnamese(str) {
      if (!str) return '';
      return str.toLowerCase().replace(/đ/g, 'd').normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
    }

    // Discord Custom Emoji Parser (§5)
    function parseDiscordEmoji(markup) {
      if (!markup) return null;
      const match = markup.match(/<(a?):([a-zA-Z0-9_~]+):([0-9]{17,21})>/);
      if (match) {
        const animated = match[1] === 'a';
        const name = match[2];
        const id = match[3];
        const ext = animated ? 'gif' : 'webp';
        return {
          isCustom: true,
          animated,
          name,
          id,
          url: `https://cdn.discordapp.com/emojis/${id}.${ext}?size=96&quality=lossless`
        };
      }
      return { isCustom: false, text: markup };
    }

    // Safe Markdown & Custom Emoji Renderer for Descriptions
    function renderSafeDescription(rawText) {
      if (!rawText) return '';
      let text = rawText
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Restore custom Discord emoji markup securely
      text = text.replace(/&lt;(a?):([a-zA-Z0-9_~]+):([0-9]{17,21})&gt;/g, (m, a, name, id) => {
        const ext = a === 'a' ? 'gif' : 'webp';
        return `<img class="discord-inline-emoji" src="https://cdn.discordapp.com/emojis/${id}.${ext}?size=48&quality=lossless" alt=":${name}:" title=":${name}:" loading="lazy" />`;
      });

      // Basic safe markdown
      text = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      text = text.replace(/\*(.*?)\*/g, '<em>$1</em>');
      text = text.replace(/^&gt;\s*(.*$)/gm, '<blockquote style="border-left: 2px solid var(--silver-dim); padding-left: 0.6rem; color: var(--off-white); margin: 0.35rem 0;">$1</blockquote>');
      text = text.replace(/^- (.*$)/gm, '<li style="margin-left: 1.25rem;">$1</li>');
      text = text.replace(/\n/g, '<br/>');

      return text;
    }

    // ── APPLICATION STATE ──
    let allProducts = <%- JSON.stringify(typeof catalog !== 'undefined' && catalog && catalog.products ? catalog.products : []) %>;
    let allCategories = <%- JSON.stringify(typeof catalog !== 'undefined' && catalog && catalog.categories ? catalog.categories : []) %>;
    let currentCategory = allCategories[0] ? allCategories[0].slug : 'nitro-trial';
    let searchQuery = '';
    let currentSort = 'default';
    let currentVersion = <%= typeof catalog !== 'undefined' && catalog && catalog.version ? catalog.version : 1 %>;
    let currentUser = null;
    let isPreviewMode = false;

    // Toast Helper
    function showToast(msg) {
      const toast = document.getElementById('liveToast');
      document.getElementById('toastMessage').textContent = msg || 'Menu vừa được cập nhật ✧';
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3500);
    }

    // Modal Helpers
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add('active');
    }
    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('active');
    }

    // ── AUTHENTICATION CHECK ──
    async function checkAuth() {
      try {
        const res = await fetch('/api/auth/me', { credentials: 'include' });
        if (res.ok) {
          const data = await res.json();
          if (data && data.authenticated) {
            currentUser = data;
            const loginBtn = document.getElementById('btnLoginDiscord');
            if (loginBtn) loginBtn.style.display = 'none';
            const chip = document.getElementById('userProfileChip');
            chip.classList.add('show');
            document.getElementById('userNameLabel').textContent = data.username || 'User';

            if (data.avatar && data.discordId) {
              document.getElementById('userAvatarImg').src = `https://cdn.discordapp.com/avatars/${data.discordId}/${data.avatar}.webp?size=64`;
            }

            const badge = document.getElementById('userRoleBadge');
            badge.textContent = data.role;
            if (data.role === 'OWNER') badge.className = 'role-badge role-owner';
            else if (data.role === 'ADMIN') badge.className = 'role-badge role-admin';
            else badge.className = 'role-badge role-member';

            // Show admin toolbar if owner or admin
            if (data.isAdmin) {
              document.getElementById('adminTools').classList.add('show');
              renderProducts(); // Re-render to show admin card buttons
            }
          }
        }
      } catch (err) {
        console.warn('Auth check silent backoff:', err.message);
      }
    }

    // ── CATALOG DATA LOADER ──
    async function loadCatalog() {
      try {
        let endpoint = '/api/menu';
        if (isPreviewMode && currentUser && currentUser.isAdmin) {
          endpoint = '/api/admin/menu/products';
        }

        const res = await fetch(endpoint, { credentials: 'include' });
        if (res.ok) {
          const data = await res.json();
          if (data && data.products) {
            allProducts = data.products;
            if (data.categories) allCategories = data.categories;
            if (data.version) currentVersion = data.version;
            renderCategories();
            renderProducts();
          }
        }
      } catch (err) {
        console.warn('Catalog refresh fallback:', err.message);
      }
    }

    // ── MORPH MENU NAVIGATION (ẢNH 1 PARITY) ──
    function toggleMorphMenu(forceState) {
      const btn = document.getElementById('btnMorphMenu');
      const dropdown = document.getElementById('morphMenuDropdown');
      const backdrop = document.getElementById('morphMenuBackdrop');
      if (!btn || !dropdown || !backdrop) return;

      const isOpen = typeof forceState === 'boolean' ? forceState : !dropdown.classList.contains('is-open');
      btn.classList.toggle('is-open', isOpen);
      dropdown.classList.toggle('is-open', isOpen);
      backdrop.classList.toggle('is-open', isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggleMorphMenu(false);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 960) toggleMorphMenu(false);
    });

    // Helper to extract tag labels from product name brackets, e.g. [ Nuôi Mail ], [ Không Nuôi Mail ]
    function parseProductTagsAndTitle(rawName) {
      const tags = [];
      if (!rawName) return { title: '', tags };

      const cleanTitle = rawName.replace(/\[\s*(.*?)\s*\]/g, (match, tag) => {
        if (tag && tag.trim()) tags.push(tag.trim());
        return '';
      }).trim();

      return {
        title: cleanTitle || rawName,
        tags
      };
    }

    // ── RENDER CATEGORIES (DESKTOP SIDEBAR, MOBILE CATEGORY BAR & MORPH MENU DROPDOWN) ──
    function renderCategories() {
      const sidebarContainer = document.getElementById('categoryList');
      const morphContainer = document.getElementById('morphMenuList');
      const mobileCatBar = document.getElementById('mobileCategoryBar');

      // Calculate total active count
      const totalCount = allProducts.filter(p => isPreviewMode ? true : p.status === 'ACTIVE').length;
      const sidebarCountEl = document.getElementById('sidebarTotalCount');
      if (sidebarCountEl) sidebarCountEl.textContent = totalCount;

      // Fallback: If currentCategory is not in list of active categories, select first category
      if (!allCategories.some(c => c.slug === currentCategory)) {
        currentCategory = allCategories[0] ? allCategories[0].slug : 'nitro-trial';
      }

      // 1. Desktop Sidebar Render
      if (sidebarContainer) {
        sidebarContainer.innerHTML = '';
        allCategories.forEach(cat => {
          const catProducts = allProducts.filter(p => (p.category_slug === cat.slug || p.category_id === cat.id) && (isPreviewMode ? true : p.status === 'ACTIVE'));
          const count = catProducts.length;

          const item = document.createElement('button');
          item.type = 'button';
          item.className = 'category-item ' + (currentCategory === cat.slug ? 'active' : '');

          const emojiInfo = parseDiscordEmoji(cat.emoji);
          let iconHtml = '📦';
          if (emojiInfo && emojiInfo.isCustom) {
            iconHtml = `<img src="${emojiInfo.url}" alt="${emojiInfo.name}" loading="lazy" />`;
          } else if (emojiInfo && emojiInfo.text) {
            iconHtml = emojiInfo.text;
          }

          item.innerHTML = `
            <div class="category-left">
              <span class="category-icon">${iconHtml}</span>
              <span class="category-label">${cat.name}</span>
            </div>
            <span class="category-badge">${count}</span>
          `;
          item.onclick = () => selectCategory(cat.slug);
          sidebarContainer.appendChild(item);
        });
      }

      // 2. Mobile Swipeable Category Bar (Label Pills)
      if (mobileCatBar) {
        mobileCatBar.innerHTML = '';
        allCategories.forEach(cat => {
          const catProducts = allProducts.filter(p => (p.category_slug === cat.slug || p.category_id === cat.id) && (isPreviewMode ? true : p.status === 'ACTIVE'));
          const count = catProducts.length;

          const pill = document.createElement('button');
          pill.type = 'button';
          pill.className = 'mobile-cat-pill ' + (currentCategory === cat.slug ? 'active' : '');

          const emojiInfo = parseDiscordEmoji(cat.emoji);
          let iconHtml = '📦';
          if (emojiInfo && emojiInfo.isCustom) {
            iconHtml = `<img src="${emojiInfo.url}" alt="${emojiInfo.name}" style="width: 1rem; height: 1rem; object-fit: contain;" />`;
          } else if (emojiInfo && emojiInfo.text) {
            iconHtml = emojiInfo.text;
          }

          pill.innerHTML = `
            <span>${iconHtml}</span>
            <span>${cat.name}</span>
            <span class="cat-pill-count">${count}</span>
          `;
          pill.onclick = () => selectCategory(cat.slug);
          mobileCatBar.appendChild(pill);
        });
      }

      // 3. Floating Morph Menu Dropdown Render (Ảnh 1)
      if (morphContainer) {
        morphContainer.innerHTML = '';
        allCategories.forEach(cat => {
          const catProducts = allProducts.filter(p => (p.category_slug === cat.slug || p.category_id === cat.id) && (isPreviewMode ? true : p.status === 'ACTIVE'));
          const count = catProducts.length;

          const mBtn = document.createElement('button');
          mBtn.type = 'button';
          mBtn.className = 'morph-menu-item ' + (currentCategory === cat.slug ? 'active' : '');

          const emojiInfo = parseDiscordEmoji(cat.emoji);
          let iconHtml = '📦';
          if (emojiInfo && emojiInfo.isCustom) {
            iconHtml = `<img src="${emojiInfo.url}" alt="${emojiInfo.name}" loading="lazy" />`;
          } else if (emojiInfo && emojiInfo.text) {
            iconHtml = emojiInfo.text;
          }

          mBtn.innerHTML = `
            <div class="morph-menu-item-left">
              <span class="morph-menu-item-icon">${iconHtml}</span>
              <span>${cat.name}</span>
            </div>
            <span class="morph-menu-badge">${count}</span>
          `;
          mBtn.onclick = () => {
            selectCategory(cat.slug);
            toggleMorphMenu(false);
          };
          morphContainer.appendChild(mBtn);
        });

        // Quick Subdomain Links Divider & Items (Rules, ToS, Pay, Discord)
        const subDivider = document.createElement('div');
        subDivider.style.borderTop = '1px solid rgba(255,255,255,0.08)';
        subDivider.style.margin = '0.5rem 0';
        morphContainer.appendChild(subDivider);

        const sublinks = [
          { name: 'Nội Quy Server (Rules)', href: 'https://rules.sorae.tokyo', icon: '📜' },
          { name: 'Điều Khoản Dịch Vụ (ToS)', href: 'https://tos.sorae.tokyo', icon: '⚖️' },
          { name: 'Cổng Thanh Toán Napas', href: 'https://payment.sorae.tokyo', icon: '💳' },
          { name: 'Cộng Đồng Discord Pade', href: 'https://discord.gg/pade', icon: '💬' }
        ];

        sublinks.forEach(link => {
          const a = document.createElement('a');
          a.href = link.href;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'morph-menu-item';
          a.style.textDecoration = 'none';
          a.innerHTML = `
            <div class="morph-menu-item-left">
              <span class="morph-menu-item-icon">${link.icon}</span>
              <span>${link.name}</span>
            </div>
            <span class="morph-menu-badge" style="font-size: 0.75rem;">↗</span>
          `;
          morphContainer.appendChild(a);
        });
      }
    }

    function selectCategory(slug) {
      currentCategory = slug;
      renderCategories();
      renderProducts();

      // Update active category title
      const found = allCategories.find(c => c.slug === slug);
      const titleEl = document.getElementById('activeCategoryTitle');
      if (titleEl) titleEl.textContent = found ? found.name : slug;
    }

    // ── RENDER PRODUCTS (2-COLUMN CARDS WITH BADGES & CLEAN LABELS) ──
    function renderProducts() {
      const grid = document.getElementById('productGrid');
      if (!grid) return;
      const foldedQ = foldVietnamese(searchQuery);

      let list = allProducts.filter(p => {
        if (!isPreviewMode && p.status === 'DRAFT') return false;

        const matchCat = p.category_slug === currentCategory;
        if (!matchCat) return false;

        if (!foldedQ) return true;
        const nameFold = foldVietnamese(p.name);
        const skuFold = foldVietnamese(p.sku);
        const descFold = foldVietnamese(p.short_description || '');
        return nameFold.includes(foldedQ) || skuFold.includes(foldedQ) || descFold.includes(foldedQ);
      });

      // Sorting
      if (currentSort === 'price_asc') {
        list.sort((a, b) => (Number(a.price_amount) || 0) - (Number(b.price_amount) || 0));
      } else if (currentSort === 'price_desc') {
        list.sort((a, b) => (Number(b.price_amount) || 0) - (Number(a.price_amount) || 0));
      } else if (currentSort === 'name_asc') {
        list.sort((a, b) => a.name.localeCompare(b.name, 'vi'));
      } else {
        list.sort((a, b) => (a.sort_order || 10) - (b.sort_order || 10));
      }

      const badgeCountEl = document.getElementById('categoryBadgeCount');
      if (badgeCountEl) badgeCountEl.textContent = `${list.length} sản phẩm`;

      if (list.length === 0) {
        grid.innerHTML = `
          <div style="grid-column: 1/-1; text-align: center; padding: 4rem 1rem; color: var(--ash);">
            <div style="font-size: 2.25rem; margin-bottom: 0.75rem;">𐙚</div>
            <p style="font-size: 0.9375rem; color: var(--text-sub);">Không tìm thấy sản phẩm nào trong danh mục này.</p>
          </div>
        `;
        return;
      }

      grid.innerHTML = '';
      const isAdmin = currentUser && currentUser.isAdmin;

      list.forEach(p => {
        const card = document.createElement('div');
        card.className = 'product-card';
        card.id = `card-${p.id}`;

        // Emoji / Icon parsing
        const emojiMarkup = p.emoji_markup || (p.discord_select_emoji_id ? `<${p.discord_select_emoji_animated ? 'a' : ''}:${p.discord_select_emoji_name}:${p.discord_select_emoji_id}>` : p.discord_select_emoji_name);
        const emojiInfo = parseDiscordEmoji(emojiMarkup);

        let tileContent = '📦';
        if (emojiInfo && emojiInfo.isCustom) {
          tileContent = `<img src="${emojiInfo.url}" alt="${emojiInfo.name}" loading="lazy" />`;
        } else if (emojiInfo && emojiInfo.text) {
          tileContent = `<span class="tile-unicode">${emojiInfo.text}</span>`;
        }

        const isSoldOut = p.status === 'SOLD_OUT';
        const isDraft = p.status === 'DRAFT';
        const hasSale = Number(p.compare_at_price) > Number(p.price_amount);
        const parsed = parseProductTagsAndTitle(p.name);

        card.innerHTML = `
          <div class="card-top-row">
            <div class="product-tile">${tileContent}</div>
            <div class="card-labels">
              ${hasSale ? '<span class="badge badge-sale">Sale</span>' : ''}
              ${parsed.tags.map(t => `<span class="badge badge-tag">${t}</span>`).join('')}
              ${isSoldOut ? '<span class="badge badge-soldout">Hết hàng</span>' : ''}
              ${isDraft ? '<span class="badge badge-draft">Draft</span>' : ''}
            </div>
          </div>

          <div class="card-body">
            <h3 class="card-product-title" title="${p.name}">${parsed.title}</h3>
            <p class="card-product-sub">${p.short_description || p.category_name || 'Chính hãng Pade Store'}</p>
          </div>

          <div class="card-pricing-row">
            <div class="card-price-stack">
              <span class="card-price">${formatBrandMoney(p.price_amount)}</span>
              ${hasSale ? `<span class="card-compare">${formatBrandMoney(p.compare_at_price)}</span>` : ''}
            </div>
            ${isAdmin ? `
              <div class="card-admin-actions">
                <button class="btn-card-admin" type="button" title="Sửa sản phẩm" onclick="openEditProductModal('${p.id}')">✏️</button>
                <button class="btn-card-admin delete" type="button" title="Xóa/Lưu trữ" onclick="openDeleteProductModal('${p.id}')">🗑️</button>
              </div>
            ` : ''}
          </div>
        `;

        grid.appendChild(card);
      });
    }

    // ── QUICK VIEW MODAL ──
    function openQuickView(product) {
      document.getElementById('modalTitle').textContent = product.name;
      document.getElementById('modalPrice').textContent = formatBrandMoney(product.price_amount);

      const hasSale = Number(product.compare_at_price) > Number(product.price_amount);
      const compEl = document.getElementById('modalComparePrice');
      if (hasSale) {
        compEl.textContent = formatBrandMoney(product.compare_at_price);
        compEl.style.display = 'inline';
      } else {
        compEl.style.display = 'none';
      }

      // Tile in modal
      const emojiMarkup = product.emoji_markup || (product.discord_select_emoji_id ? `<${product.discord_select_emoji_animated ? 'a' : ''}:${product.discord_select_emoji_name}:${product.discord_select_emoji_id}>` : product.discord_select_emoji_name);
      const emojiInfo = parseDiscordEmoji(emojiMarkup);
      let tileHtml = '📦';
      if (emojiInfo && emojiInfo.isCustom) {
        tileHtml = `<img src="${emojiInfo.url}" alt="${emojiInfo.name}" />`;
      } else if (emojiInfo && emojiInfo.text) {
        tileHtml = `<span class="tile-unicode">${emojiInfo.text}</span>`;
      }
      document.getElementById('modalProductTile').innerHTML = tileHtml;

      document.getElementById('modalDesc').innerHTML = renderSafeDescription(product.description || product.short_description || 'Sản phẩm dịch vụ chính hãng tại Pade Store.');

      openModal('quickViewModal');

      // Update URL query ?product=slug
      const url = new URL(window.location);
      url.searchParams.set('product', product.slug || product.sku);
      window.history.pushState({}, '', url);
    }

    document.getElementById('modalCloseBtn').addEventListener('click', () => {
      closeModal('quickViewModal');
      const url = new URL(window.location);
      url.searchParams.delete('product');
      window.history.pushState({}, '', url);
    });

    // ── ADMIN PRODUCT CRUD HANDLERS ──
    function populateCategorySelect(selectId, selectedId) {
      const select = document.getElementById(selectId);
      select.innerHTML = '';
      allCategories.forEach(cat => {
        const opt = document.createElement('option');
        opt.value = cat.id;
        opt.textContent = `${cat.name} (${cat.slug})`;
        if (selectedId && (cat.id === selectedId || cat.slug === selectedId)) {
          opt.selected = true;
        }
        select.appendChild(opt);
      });
    }

    function updateEmojiPreview(val, containerId) {
      const info = parseDiscordEmoji(val);
      const box = document.getElementById(containerId);
      if (info && info.isCustom) {
        box.innerHTML = `<img src="${info.url}" alt="${info.name}" />`;
      } else if (info && info.text) {
        box.textContent = info.text;
      } else {
        box.textContent = '📦';
      }
    }

    function openCreateProductModal() {
      populateCategorySelect('createCategory');
      document.getElementById('createProductForm').reset();
      updateEmojiPreview('', 'createEmojiPreview');
      openModal('createProductModal');
    }

    async function handleCreateProduct(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSubmitCreate');
      btn.disabled = true;

      const payload = {
        name: document.getElementById('createName').value.trim(),
        sku: document.getElementById('createSku').value.trim(),
        category_id: document.getElementById('createCategory').value,
        status: document.getElementById('createStatus').value,
        price_amount: document.getElementById('createPrice').value,
        compare_at_price: document.getElementById('createComparePrice').value || null,
        emoji_markup: document.getElementById('createEmoji').value.trim(),
        short_description: document.getElementById('createShortDesc').value.trim(),
        description: document.getElementById('createDesc').value.trim(),
        sort_order: parseInt(document.getElementById('createSortOrder').value, 10) || 10,
        is_featured: document.getElementById('createFeatured').checked
      };

      try {
        const res = await fetch('/api/admin/menu/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Tạo sản phẩm thất bại');

        showToast('✓ Đã tạo sản phẩm thành công!');
        closeModal('createProductModal');
        await loadCatalog();
      } catch (err) {
        alert('Lỗi: ' + err.message);
      } finally {
        btn.disabled = false;
      }
    }

    function openEditProductModal(productId) {
      const p = allProducts.find(item => item.id === productId);
      if (!p) return;

      populateCategorySelect('editCategory', p.category_id);
      document.getElementById('editProductId').value = p.id;
      document.getElementById('editProductVersion').value = p.version || 1;
      document.getElementById('editName').value = p.name;
      document.getElementById('editSku').value = p.sku;
      document.getElementById('editStatus').value = p.status;
      document.getElementById('editPrice').value = p.price_amount;
      document.getElementById('editComparePrice').value = p.compare_at_price || '';

      const emojiVal = p.emoji_markup || (p.discord_select_emoji_id ? `<${p.discord_select_emoji_animated ? 'a' : ''}:${p.discord_select_emoji_name}:${p.discord_select_emoji_id}>` : p.discord_select_emoji_name) || '';
      document.getElementById('editEmoji').value = emojiVal;
      updateEmojiPreview(emojiVal, 'editEmojiPreview');

      document.getElementById('editShortDesc').value = p.short_description || '';
      document.getElementById('editDesc').value = p.description || '';
      document.getElementById('editSortOrder').value = p.sort_order || 10;
      document.getElementById('editFeatured').checked = !!p.is_featured;

      openModal('editProductModal');
    }

    async function handleEditProduct(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSubmitEdit');
      btn.disabled = true;

      const id = document.getElementById('editProductId').value;
      const payload = {
        name: document.getElementById('editName').value.trim(),
        category_id: document.getElementById('editCategory').value,
        status: document.getElementById('editStatus').value,
        price_amount: document.getElementById('editPrice').value,
        compare_at_price: document.getElementById('editComparePrice').value || null,
        emoji_markup: document.getElementById('editEmoji').value.trim(),
        short_description: document.getElementById('editShortDesc').value.trim(),
        description: document.getElementById('editDesc').value.trim(),
        sort_order: parseInt(document.getElementById('editSortOrder').value, 10) || 10,
        is_featured: document.getElementById('editFeatured').checked,
        expected_version: document.getElementById('editProductVersion').value
      };

      try {
        const res = await fetch(`/api/admin/menu/product?id=${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Cập nhật thất bại');

        showToast('✓ Cập nhật sản phẩm thành công!');
        closeModal('editProductModal');
        await loadCatalog();
      } catch (err) {
        alert('Lỗi: ' + err.message);
      } finally {
        btn.disabled = false;
      }
    }

    function openDeleteProductModal(productId) {
      const p = allProducts.find(item => item.id === productId);
      if (!p) return;
      document.getElementById('deleteProductId').value = p.id;
      document.getElementById('deleteProductName').textContent = p.name;
      document.getElementById('deleteProductSku').textContent = p.sku;
      openModal('deleteProductModal');
    }

    async function confirmDeleteProduct() {
      const id = document.getElementById('deleteProductId').value;
      try {
        const res = await fetch(`/api/admin/menu/product?id=${id}`, {
          method: 'DELETE',
          credentials: 'include'
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Xóa thất bại');

        showToast('✓ Đã lưu trữ/xóa sản phẩm!');
        closeModal('deleteProductModal');
        await loadCatalog();
      } catch (err) {
        alert('Lỗi: ' + err.message);
      }
    }

    function openManageProductsModal() {
      const tbody = document.getElementById('adminProductsTableBody');
      tbody.innerHTML = '';
      allProducts.forEach(p => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><code>${p.sku}</code></td>
          <td style="font-weight: 700; color: #fff;">${p.name}</td>
          <td>${p.category_name || '-'}</td>
          <td>${formatBrandMoney(p.price_amount)}</td>
          <td><span class="badge ${p.status === 'ACTIVE' ? 'badge-sale' : 'badge-draft'}">${p.status}</span></td>
          <td>
            <button class="btn-card-admin" onclick="closeModal('manageProductsModal'); openEditProductModal('${p.id}')">✏️</button>
            <button class="btn-card-admin delete" onclick="closeModal('manageProductsModal'); openDeleteProductModal('${p.id}')">🗑️</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
      openModal('manageProductsModal');
    }

    // Toggle Preview Mode
    function togglePreviewMode() {
      isPreviewMode = !isPreviewMode;
      const btn = document.getElementById('btnTogglePreview');
      const banner = document.getElementById('previewBanner');
      if (isPreviewMode) {
        btn.classList.add('active');
        banner.classList.add('show');
        document.getElementById('previewBtnLabel').textContent = 'Preview: ON';
        showToast('Đang bật chế độ Preview (Drafts)');
      } else {
        btn.classList.remove('active');
        banner.classList.remove('show');
        document.getElementById('previewBtnLabel').textContent = 'Preview';
        showToast('Đã tắt chế độ Preview');
      }
      loadCatalog();
    }

    // ── REALTIME LIVESYNC (§10, §12.3) ──
    let pollInterval = null;

    async function checkVersion() {
      if (document.hidden) return; // Silent pause when background tab

      try {
        const res = await fetch('/api/menu?action=version', {
          headers: { 'If-None-Match': `"menu-v${currentVersion}"` }
        });

        if (res.status === 200) {
          const data = await res.json();
          if (data.version && data.version !== currentVersion) {
            currentVersion = data.version;
            showToast('✧ Bảng giá vừa được cập nhật ✧');
            await loadCatalog();
          }
        }
      } catch (err) {
        // Silent backoff
      }
    }

    function startLiveSync() {
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(checkVersion, 3000);
    }

    // ── ATTACH LISTENERS & BOOT ──
    document.getElementById('searchInput').addEventListener('input', (e) => {
      searchQuery = e.target.value;
      renderProducts();
    });

    const sortSelectEl = document.getElementById('sortSelect');
    if (sortSelectEl) {
      sortSelectEl.addEventListener('change', (e) => {
        currentSort = e.target.value;
        renderProducts();
      });
    }

    document.getElementById('btnTogglePreview').addEventListener('click', togglePreviewMode);
    document.getElementById('btnManageProducts').addEventListener('click', openManageProductsModal);
    document.getElementById('btnCreateProduct').addEventListener('click', openCreateProductModal);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-overlay.active').forEach(m => m.classList.remove('active'));
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) checkVersion();
    });

    // Check URL product parameter on boot
    function checkUrlParam() {
      const params = new URLSearchParams(window.location.search);
      const productSlug = params.get('product');
      if (productSlug && allProducts.length > 0) {
        const found = allProducts.find(p => p.slug === productSlug || p.sku.toLowerCase() === productSlug.toLowerCase());
        if (found) openQuickView(found);
      }
    }

    // Initial render from embedded catalog (instant 0ms!), then verify auth & sync
    renderCategories();
    renderProducts();
    checkAuth();
    loadCatalog();
    startLiveSync();
  </script>

  <script>
    /* ── Premium FX interactions (scroll hairline + card spotlight) ── */
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1) Scroll progress hairline
      var bar = document.getElementById('scrollProgress');
      if (bar) {
        var root = document.documentElement;
        var ticking = false;
        var paintProgress = function () {
          ticking = false;
          var max = root.scrollHeight - root.clientHeight;
          var ratio = max > 0 ? root.scrollTop / max : 0;
          if (ratio < 0) ratio = 0;
          if (ratio > 1) ratio = 1;
          bar.style.transform = 'scaleX(' + ratio.toFixed(4) + ')';
        };
        var onScroll = function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(paintProgress);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        paintProgress();
      }

      // 2) Pointer spotlight inside product cards
      var host = document.getElementById('productGrid');
      if (host && !reduce) {
        var card = null;
        var cx = 0;
        var cy = 0;
        var raf = 0;
        var paintSpot = function () {
          raf = 0;
          if (!card) return;
          var r = card.getBoundingClientRect();
          card.style.setProperty('--mx', (cx - r.left) + 'px');
          card.style.setProperty('--my', (cy - r.top) + 'px');
        };
        host.addEventListener('pointermove', function (e) {
          var t = e.target;
          var c = t && t.closest ? t.closest('.product-card') : null;
          if (!c) return;
          card = c;
          cx = e.clientX;
          cy = e.clientY;
          if (!raf) raf = requestAnimationFrame(paintSpot);
        }, { passive: true });
      }
    })();
  </script>
</body>
</html>
