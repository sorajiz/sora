             draggable="false" />
        <div class="tw-brand-text">
          <span class="tw-brand-name">Sora's Station</span>
          <span class="tw-brand-sub">Official Time Works</span>
        </div>
      </div>

      <div class="tw-status-cluster">
        <!-- Live Status Pill -->
        <div class="tw-status-badge active" id="liveStatusBadge">
          <span class="tw-dot-indicator" aria-hidden="true"></span>
          <span id="liveStatusText">Đang Hoạt Động</span>
        </div>

        <!-- Vietnam GMT+7 Realtime Clock -->
        <div class="tw-clock-pill">
          <svg class="tw-clock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span id="liveClockDisplay">--:--:--</span>
          <span style="opacity: 0.55; font-size: 0.72rem;">GMT+7</span>
        </div>
      </div>
    </header>

    <!-- HERO TITLE -->
    <section class="tw-hero-section">
      <div class="tw-eyebrow">Operating Schedule</div>
      <h1 class="tw-main-heading">Khung Giờ Hoạt Động</h1>
      <p class="tw-hero-desc">
        Lịch trực, tư vấn và xử lý đơn hàng chính thức tại Sora's Station. Chúng tôi luôn sẵn sàng hỗ trợ khách hàng nhanh chóng và uy tín nhất.
      </p>
    </section>

    <!-- SCHEDULE CARDS -->
    <section class="tw-schedule-grid" aria-label="Chi tiết khung giờ">
      <!-- Weekdays Card -->
      <article class="tw-card">
        <div class="tw-card-top">
          <h2 class="tw-card-day-title">Thứ Hai — Thứ Sáu</h2>
          <div class="tw-card-icon-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
        </div>

        <div class="tw-card-hours-box">
          <span class="tw-card-hours-label">Khung Giờ Phục Vụ</span>
          <span class="tw-card-hours-digits">07:00 — 23:00</span>
        </div>

        <p class="tw-card-desc">
          Tư vấn dịch vụ, tiếp nhận thanh toán và xử lý đơn hàng liên tục trong ngày làm việc.
        </p>

        <div class="tw-card-tags">
          <span class="tw-mini-tag">Tư Vấn Nhanh</span>
          <span class="tw-mini-tag">Giao Dịch Ổn Định</span>
          <span class="tw-mini-tag">Auto Delivery</span>
        </div>
      </article>

      <!-- Weekend Card -->
      <article class="tw-card">
        <div class="tw-card-top">
          <h2 class="tw-card-day-title">Thứ Bảy — Chủ Nhật</h2>
          <div class="tw-card-icon-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
        </div>

        <div class="tw-card-hours-box">
          <span class="tw-card-hours-label">Khung Giờ Cuối Tuần</span>
          <span class="tw-card-hours-digits">10:00 — 23:30</span>
        </div>

        <p class="tw-card-desc">
          Hỗ trợ kỹ thuật chuyên sâu, chăm sóc khách hàng và bảo hành đơn hàng cuối tuần.
        </p>

        <div class="tw-card-tags">
          <span class="tw-mini-tag">Hỗ Trợ Kỹ Thuật</span>
          <span class="tw-mini-tag">Bảo Hành Ticket</span>
          <span class="tw-mini-tag">Chăm Sóc Khách Hàng</span>
        </div>
      </article>
    </section>

    <!-- NOTICE BANNER -->
    <section class="tw-guideline-box">
      <svg class="tw-guideline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <p class="tw-guideline-text">
        Quý khách vui lòng hạn chế ping ngoài khung giờ phục vụ để tránh gián đoạn. Mọi yêu cầu gửi trong ticket sẽ được xử lý sớm nhất khi bắt đầu phiên làm việc!
      </p>
    </section>

    <!-- ACTIONS ROW -->
    <footer class="tw-actions-row">
      <div class="tw-primary-links">
        <!-- Join Discord Button (Target _blank dynamically, never navigates current page) -->
        <button type="button"
                class="btn-action-discord"
                id="joinDiscordBtn"
                data-invite="<%= typeof discordServerInvite !== 'undefined' ? discordServerInvite : 'https://discord.gg/YzEaab34kV' %>"
                aria-label="Tham gia Discord Server">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          <span>Mở Discord Server</span>
          <svg class="btn-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>

        <a href="<%= typeof discordUrl !== 'undefined' ? discordUrl : 'https://discord.sorae.tokyo' %>" class="btn-nav-glass" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <span>Discord Station Hub</span>
        </a>
      </div>

      <a href="<%= typeof profileUrl !== 'undefined' ? profileUrl : 'https://sorae.tokyo' %>" class="btn-nav-glass" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Trang Chủ Sora</span>
      </a>
    </footer>

  </main>

  <!-- Interactive Glass Sheen Tracking -->
  <script>
    (function () {
      "use strict";
      var frame = document.getElementById("twGlassFrame");
      if (frame && window.matchMedia("(pointer: fine)").matches) {
        frame.addEventListener("mousemove", function (e) {
          var rect = frame.getBoundingClientRect();
          frame.style.setProperty("--mouse-x", (e.clientX - rect.left) + "px");
          frame.style.setProperty("--mouse-y", (e.clientY - rect.top) + "px");
        }, { passive: true });
      }
    })();
  </script>

  <!-- Join Discord Button Handler (Opens New Tab, NEVER Redirects Current Website) -->
  <script>
    (function () {
      "use strict";
      var button = document.getElementById("joinDiscordBtn");
      if (!button) return;

      button.addEventListener("click", function (event) {
        event.preventDefault();
        event.stopPropagation();
        var invite = button.getAttribute("data-invite") || "https://discord.gg/YzEaab34kV";
        
        var link = document.createElement("a");
        link.href = invite;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.style.display = "none";
        document.body.appendChild(link);
        link.click();
        setTimeout(function () {
          if (link.parentNode) {
            link.parentNode.removeChild(link);
          }
        }, 150);
      });
    })();
  </script>

  <!-- Realtime Vietnam GMT+7 Clock & Live Working Status Engine -->
  <script>
    (function () {
      "use strict";

      var badge = document.getElementById("liveStatusBadge");
      var text = document.getElementById("liveStatusText");
      var clockEl = document.getElementById("liveClockDisplay");

      function getVnDate() {
        var now = new Date();
        var utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        return new Date(utc + (3600000 * 7));
      }

      function pad(n) {
        return n < 10 ? "0" + n : n;
      }

      function checkSchedule() {
        var vn = getVnDate();
        var day = vn.getDay(); // 0 = Sunday, 1 = Monday ... 6 = Saturday
        var hours = vn.getHours();
        var mins = vn.getMinutes();
        var currentMinutes = hours * 60 + mins;

        var isOpen = false;

        if (day >= 1 && day <= 5) {
          // Mon - Fri: 07:00 to 23:00 (420 to 1380 mins)
          isOpen = currentMinutes >= 420 && currentMinutes < 1380;
        } else {
          // Sat - Sun: 10:00 to 23:30 (600 to 1410 mins)
          isOpen = currentMinutes >= 600 && currentMinutes < 1410;
        }

        var timeString = pad(hours) + ":" + pad(mins) + ":" + pad(vn.getSeconds());

        if (clockEl) clockEl.textContent = timeString;

        if (isOpen) {
          if (badge) badge.className = "tw-status-badge active";
          if (text) text.textContent = "Đang Hoạt Động";
        } else {
          if (badge) badge.className = "tw-status-badge closed";
          if (text) text.textContent = "Nghỉ Phục Vụ";
        }
      }

      checkSchedule();
      setInterval(checkSchedule, 1000);
    })();
  </script>

</body>
</html>
