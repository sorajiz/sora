                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
              </span>
              <span>Các bước thực hiện trên Máy tính (PC / Web):</span>
            </div>
            <ul class="rules-list">
              <li class="rules-list-item"><strong>Bước 1 (Bật 2FA):</strong> Vào <strong>Cài đặt người dùng</strong> (biểu tượng Cài đặt ở góc trái phía dưới) ➔ Chọn mục <strong>My Account</strong> (Tài khoản của tôi) ➔ Cuộn xuống chọn <strong>Bật Ứng Dụng Xác Thực</strong> (Enable Two-Factor Auth).</li>
              <li class="rules-list-item"><strong>Bước 2 (Quét mã):</strong> Nhập mật khẩu tài khoản và quét mã QR bằng ứng dụng xác thực trên điện thoại (Google Authenticator, Authy, Microsoft Authenticator,...), sau đó nhập 6 số xác thực để hoàn tất.</li>
              <li class="rules-list-item"><strong>Bước 3 (Xem mã dự phòng):</strong> Sau khi kích hoạt thành công, nút <strong>Xem Mã Dự Phòng</strong> (View Backup Codes) sẽ hiển thị ngay tại mục đó. Nhấp vào để xem và tải về máy.</li>
              <li class="rules-list-item"><strong>Bước 4 (Gửi cho shop):</strong> Copy 5–10 mã dự phòng chưa dùng gửi vào ticket cùng tài khoản &amp; mật khẩu để kỹ thuật viên đăng nhập kích hoạt.</li>
            </ul>
          </div>
        </section>

        <hr class="section-divider" />

        <!-- SECTION 04: Video trực quan -->
        <section class="tos-section" id="video-huong-dan">
          <div class="section-header-row">
            <span class="number-badge">04</span>
            <h2 class="section-title">Video hướng dẫn trực quan</h2>
            <a href="#video-huong-dan" class="section-anchor-btn" title="Sao chép liên kết" onclick="copySectionLink('#video-huong-dan', event)">#</a>
          </div>
          <p style="font-size: 0.95rem; color: var(--text-sub); margin-bottom: 0.75rem;">
            Theo dõi video dưới đây để thực hiện từng bước dễ dàng nhất:
          </p>

          <div class="video-wrapper">
            <iframe
              src="https://www.youtube-nocookie.com/embed/_yauX5pVC8o"
              title="Video hướng dẫn Discord Nitro Trial"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </section>
      </div>
    </main>
  </div>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <p style="font-weight: 700; color: #fff; margin-bottom: 0.35rem;">Pade Community · Bản quyền © 2026</p>
        <p>Trung tâm tài liệu, nội quy và hướng dẫn dịch vụ khách hàng Pade Community.</p>
      </div>
      <ul class="footer-links">
        <li><a href="/rules" class="footer-link tab-switcher-link" data-tab="rules">Server Rules</a></li>
        <li><a href="/tos" class="footer-link tab-switcher-link" data-tab="tos">Terms of Service</a></li>
        <li><a href="/tutorial" class="footer-link tab-switcher-link" data-tab="tutorial">Tutorial</a></li>
      </ul>
    </div>
  </footer>

  <div class="toast" id="toastBox">
    <span>Đã sao chép liên kết!</span>
  </div>

  <script>
    // ── SLIDING TABS WITH HARDWARE ACCELERATION ──
    const navWrapper = document.getElementById('navTabsWrapper');
    const navSlider = document.getElementById('navPillSlider');
    const tabLinks = document.querySelectorAll('.nav-tab-link');
    const tabPanels = document.querySelectorAll('.tab-panel-view');
    const sidebarPanels = document.querySelectorAll('.sidebar-panel-view');

    function positionSlider(el) {
      if (!navWrapper || !navSlider || !el) return;
      const wrapRect = navWrapper.getBoundingClientRect();
      const elRect = el.getBoundingClientRect();
      navSlider.style.left = `${elRect.left - wrapRect.left}px`;
      navSlider.style.width = `${elRect.width}px`;
    }

    function switchTab(tabName, updateHistory) {
      if (!tabName) return;
      const targetBtn = document.querySelector(`.nav-tab-link[data-tab="${tabName}"]`);
      if (!targetBtn) return;

      tabLinks.forEach(link => link.classList.remove('active'));
      targetBtn.classList.add('active');
      positionSlider(targetBtn);

      tabPanels.forEach(panel => {
        const isMatch = panel.getAttribute('data-tab-content') === tabName;
        panel.classList.toggle('active', isMatch);
      });

      sidebarPanels.forEach(sb => {
        const isMatch = sb.getAttribute('data-tab-sidebar') === tabName;
        sb.classList.toggle('active', isMatch);
      });

      const targetPath = targetBtn.getAttribute('data-path') || `/${tabName}`;
      if (updateHistory) {
        if (window.location.pathname !== targetPath) {
          window.history.pushState({ tab: tabName }, '', targetPath);
        }
      }

      // Update document title dynamically
      if (tabName === 'rules') {
        document.title = 'Server Rules · Pade Community';
      } else if (tabName === 'tos') {
        document.title = 'Terms of Service · Pade Store';
      } else if (tabName === 'tutorial') {
        document.title = 'Tutorial & Hướng Dẫn · Pade Store';
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Attach click and hover events to tab buttons
    tabLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const tab = link.getAttribute('data-tab');
        switchTab(tab, true);
      });
      link.addEventListener('mouseenter', () => {
        positionSlider(link);
      });
    });

    if (navWrapper) {
      navWrapper.addEventListener('mouseleave', () => {
        const activeLink = document.querySelector('.nav-tab-link.active');
        if (activeLink) positionSlider(activeLink);
      });
    }

    // Footer switcher links
    document.querySelectorAll('.tab-switcher-link').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const tab = link.getAttribute('data-tab');
        switchTab(tab, true);
      });
    });

    // Handle browser back/forward buttons
    window.addEventListener('popstate', (e) => {
      determineInitialTab(false);
    });

    function determineInitialTab(updateHistory) {
      const path = (window.location.pathname || '').toLowerCase();
      const host = (window.location.hostname || '').toLowerCase();
      let defaultTab = '<%= typeof activeTab !== "undefined" ? activeTab : "rules" %>';

      if (path.includes('tos') || host.startsWith('tos.')) {
        defaultTab = 'tos';
      } else if (path.includes('tutorial') || host.startsWith('tutorial.')) {
        defaultTab = 'tutorial';
      } else if (path.includes('rules') || host.startsWith('rules.')) {
        defaultTab = 'rules';
      }

      switchTab(defaultTab, !!updateHistory);
    }

    // Initialize layout
    window.addEventListener('DOMContentLoaded', () => {
      determineInitialTab(false);
    });
    window.addEventListener('load', () => {
      const activeLink = document.querySelector('.nav-tab-link.active');
      if (activeLink) positionSlider(activeLink);
    });
    window.addEventListener('resize', () => {
      const activeLink = document.querySelector('.nav-tab-link.active');
      if (activeLink) positionSlider(activeLink);
    });
    if (document.fonts) {
      document.fonts.ready.then(() => {
        const activeLink = document.querySelector('.nav-tab-link.active');
        if (activeLink) positionSlider(activeLink);
      });
    }

    // Reading progress
    window.addEventListener('scroll', () => {
      const scrollTotal = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = scrollTotal > 0 ? window.scrollY / scrollTotal : 0;
      document.getElementById('readingProgress').style.transform = `scaleX(${progress})`;
    }, { passive: true });

    // ScrollSpy for Active Sidebar Nav Item & Mobile Category Bar
    window.addEventListener('scroll', () => {
      const activePanel = document.querySelector('.tab-panel-view.active');
      if (!activePanel) return;
      const sections = activePanel.querySelectorAll('.tos-section');
      const activeSidebar = document.querySelector('.sidebar-panel-view.active');
      const navItems = activeSidebar ? activeSidebar.querySelectorAll('.sidebar-nav-link') : [];
      const mobilePills = activePanel.querySelectorAll('.mobile-cat-pill');

      let current = '';
      const scrollPos = window.scrollY + 160;
      sections.forEach(sec => {
        if (scrollPos >= sec.offsetTop && scrollPos < sec.offsetTop + sec.offsetHeight) {
          current = sec.getAttribute('id');
        }
      });
      if (current) {
        navItems.forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === `#${current}`);
        });

        // Mobile Category Bar syncing
        mobilePills.forEach(pill => {
          const match = pill.getAttribute('href') === `#${current}`;
          pill.classList.toggle('active', match);
          if (match && window.innerWidth <= 900) {
            pill.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        });
      }
    }, { passive: true });

    // Smooth click handler for mobile category pills
    document.querySelectorAll('.mobile-cat-pill').forEach(pill => {
      pill.addEventListener('click', (e) => {
        const targetId = pill.getAttribute('href');
        if (targetId && targetId.startsWith('#')) {
          e.preventDefault();
          const targetEl = document.querySelector(targetId);
          if (targetEl) {
            const headerOffset = 135;
            const elementPosition = targetEl.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
            const parent = pill.parentElement;
            if (parent) {
              parent.querySelectorAll('.mobile-cat-pill').forEach(p => p.classList.remove('active'));
              pill.classList.add('active');
            }
          }
        }
      });
    });

    // Copy section link
    function copySectionLink(hash, e) {
      if (e) e.preventDefault();
      const url = `${window.location.origin}${window.location.pathname}${hash}`;
      navigator.clipboard.writeText(url).then(() => {
        const toast = document.getElementById('toastBox');
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2000);
      });
    }
  </script>
</body>
</html>
