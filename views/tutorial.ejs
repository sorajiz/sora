<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Tutorial & Hướng Dẫn · Pade Store' %></title>
  <meta name="description" content="Nội quy, điều khoản dịch vụ và hướng dẫn sử dụng chính thức tại Pade Community · discord.gg/pade" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#0c0d12" />
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://rules.sorae.tokyo' %>" />

  <!-- OpenGraph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:site_name" content="Pade Community" />
  <meta property="og:title" content="Pade Community · Rules & ToS & Tutorial" />
  <meta property="og:description" content="Nội quy, điều khoản và tài liệu hướng dẫn Discord Nitro chính thức của Pade Community." />
  <meta property="og:url" content="https://rules.sorae.tokyo" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Pade Community · Rules, ToS & Tutorial" />
  <meta name="twitter:description" content="Nội quy, điều khoản và tài liệu hướng dẫn chính thức của Pade Community." />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="<%= typeof faviconDataUri !== 'undefined' ? faviconDataUri : '/assets/favicon.png' %>" />
  <link rel="shortcut icon" type="image/png" href="/assets/favicon.png" />

  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* ── RESET & DARK GRAY DESIGN SYSTEM ── */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --bg-base: #0c0d12;
      --bg-surface: #13141a;
      --bg-surface-elevated: #181922;
      --bg-sidebar-pill: #21232d;
      --bg-badge: #1b1c24;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.16);
      --border-focus: rgba(255, 255, 255, 0.28);
      --text-white: #ffffff;
      --text-main: #f1f2f6;
      --text-sub: #c5c8d4;
      --text-muted: #838896;
      --text-dim: #5c606e;
      --accent-amber: #f59e0b;
      --accent-amber-bg: #1c160c;
      --accent-amber-border: rgba(245, 158, 11, 0.35);
      --accent-blue: #38bdf8;
      --accent-red: #ef4444;
      --accent-green: #22c55e;
      --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: "JetBrains Mono", monospace;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
      position: relative;
    }

    .ambient-mesh {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle at 15% 15%, rgba(33, 35, 45, 0.4) 0%, transparent 60%),
                  radial-gradient(circle at 85% 85%, rgba(20, 21, 28, 0.6) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    .reading-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 100%;
      background: linear-gradient(90deg, #5865f2, #38bdf8, #a855f7);
      transform-origin: 0% 50%;
      transform: scaleX(0);
      z-index: 100;
      transition: transform 0.08s ease-out;
    }

    /* ── HEADER / TOPBAR ── */
    .top-header {
      position: sticky;
      top: 0;
      width: 100%;
      z-index: 50;
      background: rgba(12, 13, 18, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-subtle);
    }

    .top-header-inner {
      max-width: 1260px;
      margin: 0 auto;
      padding: 0.85rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: inherit;
    }

    .brand-avatar {
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      overflow: hidden;
      border: 1px solid var(--border-strong);
      background: #181920;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .brand-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .brand-name {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text-white);
      letter-spacing: -0.02em;
    }

    /* ── SLIDING TABS IN HEADER (ẢNH 1 - DI CHUYỂN MƯỢT MÀ KHI NHẤN) ── */
    .nav-tabs-wrapper {
      position: relative;
      display: inline-flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid var(--border-subtle);
      border-radius: 9999px;
      padding: 4px;
      user-select: none;
    }

    .nav-pill-slider {
      position: absolute;
      top: 4px;
      bottom: 4px;
      left: 4px;
      width: 0;
      background: var(--bg-sidebar-pill);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 9999px;
      transition: left 0.28s cubic-bezier(0.16, 1, 0.3, 1), width 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
      z-index: 1;
    }

    .nav-tab-link {
      position: relative;
      z-index: 2;
      padding: 0.45rem 1.15rem;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      border-radius: 9999px;
      transition: color 0.18s ease;
      white-space: nowrap;
      cursor: pointer;
      border: none;
      background: transparent;
      font-family: inherit;
    }

    .nav-tab-link.active {
      color: var(--text-white);
      font-weight: 700;
    }

    .nav-tab-link:hover {
      color: var(--text-white);
    }

    .mobile-menu-btn {
      display: none;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 0.45rem 0.65rem;
      border-radius: 0.5rem;
      cursor: pointer;
      font-size: 0.8125rem;
      font-weight: 600;
      align-items: center;
      gap: 0.4rem;
    }

    /* ── MAIN CONTENT LAYOUT ── */
    .layout-wrapper {
      position: relative;
      z-index: 10;
      max-width: 1260px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 6rem;
      display: flex;
      align-items: flex-start;
      gap: 3.5rem;
    }

    /* ── LEFT SIDEBAR ── */
    .sidebar {
      width: 270px;
      flex-shrink: 0;
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
      padding-right: 0.5rem;
    }

    .sidebar-panel-view {
      display: none;
    }

    .sidebar-panel-view.active {
      display: block;
      animation: fadeIn 0.22s ease-out forwards;
    }

    .sidebar-group {
      margin-bottom: 2rem;
    }

    .sidebar-heading {
      font-size: 0.6875rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 0.75rem;
      padding: 0 0.75rem;
    }

    .sidebar-nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .sidebar-nav-link {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.5rem 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-muted);
      text-decoration: none;
      transition: all 0.15s ease;
    }

    .sidebar-nav-link:hover {
      color: var(--text-white);
      background: rgba(255, 255, 255, 0.04);
    }

    .sidebar-nav-link.active {
      background: var(--bg-sidebar-pill);
      color: var(--text-white);
      font-weight: 600;
    }

    .sidebar-nav-link .nav-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--text-dim);
      flex-shrink: 0;
      transition: all 0.15s ease;
    }

    .sidebar-nav-link.active .nav-dot {
      background: var(--text-white);
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
    }

    /* ── RIGHT MAIN ARTICLE AREA ── */
    .main-content {
      flex: 1;
      min-width: 0;
      max-width: 820px;
    }

    .tab-panel-view {
      display: none;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.22s ease, transform 0.22s ease;
    }

    .tab-panel-view.active {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .content-eyebrow {
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      display: block;
      margin-bottom: 0.5rem;
    }

    .hero-title {
      font-size: 2.75rem;
      font-weight: 900;
      color: var(--text-white);
      letter-spacing: -0.035em;
      line-height: 1.15;
      margin-bottom: 1rem;
    }

    /* Meta Badge with SVG Icon */
    .meta-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.85rem;
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid var(--border-subtle);
      border-radius: 9999px;
      font-size: 0.75rem;
      color: var(--text-sub);
      margin-bottom: 2rem;
    }

    .meta-icon-svg {
      display: inline-flex;
      align-items: center;
      color: var(--text-muted);
    }

    .meta-badge-link {
      color: var(--text-white);
      font-weight: 700;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .meta-badge-link:hover {
      text-decoration: underline;
      color: var(--accent-blue);
    }

    .section-divider {
      border: 0;
      border-top: 1px solid var(--border-subtle);
      margin: 2.25rem 0;
    }

    .tos-section {
      scroll-margin-top: 5.5rem;
      position: relative;
    }

    .section-header-row {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    .number-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      background: var(--bg-badge);
      border: 1px solid var(--border-subtle);
      border-radius: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      font-weight: 700;
      color: var(--text-muted);
      flex-shrink: 0;
    }

    .section-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--text-white);
      letter-spacing: -0.015em;
      line-height: 1.3;
    }

    .section-anchor-btn {
      opacity: 0;
      color: var(--text-dim);
      text-decoration: none;
      font-size: 1rem;
      margin-left: 0.35rem;
      transition: all 0.15s ease;
    }

    .tos-section:hover .section-anchor-btn {
      opacity: 1;
    }

    .rules-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      margin: 0.85rem 0;
    }

    .rules-list-item {
      position: relative;
      padding-left: 1.25rem;
      font-size: 0.9375rem;
      color: var(--text-main);
      line-height: 1.65;
    }

    .rules-list-item::before {
      content: "•";
      position: absolute;
      left: 0.25rem;
      color: var(--text-dim);
      font-weight: bold;
    }

    .rules-list-item strong {
      color: var(--text-white);
    }

    /* Rule Card with Clean SVG Icon */
    .rule-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 0.85rem;
      padding: 1.25rem 1.35rem;
      margin: 1rem 0;
      transition: border-color 0.15s ease;
    }

    .rule-card:hover {
      border-color: var(--border-strong);
    }

    .rule-card-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-white);
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.55rem;
    }

    .icon-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.65rem;
      height: 1.65rem;
      border-radius: 0.4rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      flex-shrink: 0;
    }

    .icon-badge.text-cyan { color: #38bdf8; background: rgba(56, 189, 248, 0.08); border-color: rgba(56, 189, 248, 0.2); }
    .icon-badge.text-purple { color: #c084fc; background: rgba(192, 132, 252, 0.08); border-color: rgba(192, 132, 252, 0.2); }
    .icon-badge.text-amber { color: #f59e0b; background: rgba(245, 158, 11, 0.08); border-color: rgba(245, 158, 11, 0.2); }
    .icon-badge.text-pink { color: #f472b6; background: rgba(244, 114, 182, 0.08); border-color: rgba(244, 114, 182, 0.2); }
    .icon-badge.text-yellow { color: #facc15; background: rgba(250, 204, 21, 0.08); border-color: rgba(250, 204, 21, 0.2); }
    .icon-badge.text-blue { color: #60a5fa; background: rgba(96, 165, 250, 0.08); border-color: rgba(96, 165, 250, 0.2); }
    .icon-badge.text-green { color: #22c55e; background: rgba(34, 197, 94, 0.08); border-color: rgba(34, 197, 94, 0.2); }
    .icon-badge.text-red { color: #ef4444; background: rgba(239, 68, 68, 0.08); border-color: rgba(239, 68, 68, 0.2); }

    .callout-box {
      background: var(--accent-amber-bg);
      border: 1px solid var(--accent-amber-border);
      border-left: 4px solid var(--accent-amber);
      border-radius: 0.65rem;
      padding: 0.95rem 1.25rem;
      margin: 1.15rem 0;
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .callout-icon {
      color: var(--accent-amber);
      flex-shrink: 0;
      margin-top: 0.15rem;
    }

    .callout-content {
      font-size: 0.9rem;
      font-weight: 600;
      color: #fef3c7;
      line-height: 1.55;
    }

    /* Formula Box for Refund Calculation */
    .formula-box {
      background: #10121a;
      border: 1px solid rgba(56, 189, 248, 0.25);
      border-radius: 0.75rem;
      padding: 1.15rem 1.35rem;
      margin: 1rem 0;
    }

    .formula-title {
      font-size: 0.8125rem;
      font-weight: 700;
      color: #38bdf8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .formula-code {
      font-family: var(--font-mono);
      font-size: 0.925rem;
      font-weight: 700;
      color: #fff;
      background: rgba(0, 0, 0, 0.4);
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      overflow-x: auto;
      white-space: nowrap;
    }

    .feedback-channel-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.35rem 0.75rem;
      background: rgba(88, 101, 242, 0.15);
      border: 1px solid rgba(88, 101, 242, 0.35);
      border-radius: 0.45rem;
      color: #85b0ff;
      font-size: 0.8125rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.15s ease;
      margin: 0.25rem 0;
    }

    .feedback-channel-badge:hover {
      background: rgba(88, 101, 242, 0.25);
      color: #fff;
      border-color: rgba(88, 101, 242, 0.6);
      transform: translateY(-1px);
    }

    .promo-checker-box {
      background: linear-gradient(135deg, #181922 0%, #13141a 100%);
      border: 1px solid var(--border-strong);
      border-radius: 0.85rem;
      padding: 1.35rem 1.5rem;
      margin: 1.25rem 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .promo-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 0.5rem;
      color: #fff;
      font-size: 0.8125rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.18s ease;
      align-self: flex-start;
    }

    .promo-link-btn:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
      transform: translateY(-1px);
    }

    .video-wrapper {
      position: relative;
      width: 100%;
      padding-bottom: 56.25%;
      height: 0;
      border-radius: 0.85rem;
      overflow: hidden;
      border: 1px solid var(--border-strong);
      background: #111218;
      margin: 1.25rem 0;
    }

    .video-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .site-footer {
      border-top: 1px solid var(--border-subtle);
      background: #090a0d;
      padding: 3rem 1.5rem;
      color: var(--text-muted);
      font-size: 0.8125rem;
    }

    .footer-inner {
      max-width: 1260px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
    }

    .footer-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      list-style: none;
    }

    .footer-link {
      color: var(--text-sub);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .footer-link:hover {
      color: var(--text-white);
    }

    .toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #1c1d26;
      border: 1px solid var(--border-strong);
      color: var(--text-white);
      padding: 0.75rem 1.25rem;
      border-radius: 0.55rem;
      font-size: 0.875rem;
      font-weight: 600;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
      z-index: 1000;
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* ── MOBILE CATEGORY CHIPS BAR (EXACT MENU PARITY) ── */
    .mobile-category-bar {
      display: none;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 0.5rem;
      padding: 0.65rem 0.25rem 0.75rem;
      margin: -0.25rem 0 1.5rem 0;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      position: sticky;
      top: 5.75rem;
      z-index: 40;
      background: rgba(12, 13, 18, 0.94);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .mobile-category-bar::-webkit-scrollbar {
      display: none;
    }

    .mobile-cat-pill {
      background: #13141a;
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: var(--text-sub);
      padding: 0.45rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.78125rem;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      text-decoration: none;
      flex-shrink: 0;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mobile-cat-pill:active {
      transform: scale(0.96);
    }
    .mobile-cat-pill.active {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.14), rgba(201, 204, 210, 0.05));
      border-color: rgba(201, 204, 210, 0.45);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }

    .header-discord-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.35rem 0.75rem;
      background: rgba(88, 101, 242, 0.15);
      border: 1px solid rgba(88, 101, 242, 0.35);
      border-radius: 9999px;
      color: #85b0ff;
      font-size: 0.75rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.18s ease;
    }
    .header-discord-badge:hover {
