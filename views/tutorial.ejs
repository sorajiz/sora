  </div>

  <script>
    // Sliding pill slider
    const navWrapper = document.getElementById('navTabsWrapper');
    const navSlider = document.getElementById('navPillSlider');
    const tabLinks = document.querySelectorAll('.nav-tab-link');

    function positionSlider(el) {
      if (!navWrapper || !navSlider || !el) return;
      const wrapRect = navWrapper.getBoundingClientRect();
      const elRect = el.getBoundingClientRect();
      navSlider.style.left = `${elRect.left - wrapRect.left}px`;
      navSlider.style.width = `${elRect.width}px`;
    }

    const activeTab = document.querySelector('.nav-tab-link.active') || tabLinks[2];
    if (activeTab) positionSlider(activeTab);

    tabLinks.forEach(tab => {
      tab.addEventListener('mouseenter', () => positionSlider(tab));
    });
    if (navWrapper && activeTab) {
      navWrapper.addEventListener('mouseleave', () => positionSlider(activeTab));
    }
    window.addEventListener('resize', () => {
      if (activeTab) positionSlider(activeTab);
    });

    // Reading progress
    window.addEventListener('scroll', () => {
      const scrollTotal = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = scrollTotal > 0 ? window.scrollY / scrollTotal : 0;
      document.getElementById('readingProgress').style.transform = `scaleX(${progress})`;
    }, { passive: true });

    // ScrollSpy
    const sections = document.querySelectorAll('.tos-section');
    const navItems = document.querySelectorAll('.sidebar-nav-link');

    window.addEventListener('scroll', () => {
      let current = '';
      const scrollPos = window.scrollY + 140;
      sections.forEach(sec => {
        if (scrollPos >= sec.offsetTop && scrollPos < sec.offsetTop + sec.offsetHeight) {
          current = sec.getAttribute('id');
        }
      });
      if (current) {
        navItems.forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === `#${current}`);
        });
      }
    }, { passive: true });

    function copySectionLink(hash, e) {
      if (e) e.preventDefault();
      const url = `${window.location.origin}${window.location.pathname}${hash}`;
      navigator.clipboard.writeText(url).then(() => {
        const toast = document.getElementById('toastBox');
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2000);
      });
    }

    const mobileBtn = document.getElementById('mobileMenuToggle');
    const sidebar = document.getElementById('pageSidebar');
    const backdrop = document.getElementById('sidebarBackdrop');

    if (mobileBtn && sidebar && backdrop) {
      mobileBtn.addEventListener('click', () => {
        sidebar.classList.add('open');
        backdrop.classList.add('open');
      });
      backdrop.addEventListener('click', () => {
        sidebar.classList.remove('open');
        backdrop.classList.remove('open');
      });
    }
  </script>
