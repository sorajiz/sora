        </div>

        <div class="editorial-hero-text">
          <h1 class="editorial-title">
            <em>Join the<br />Station.</em>
          </h1>
          <p class="editorial-desc">
            A small place for creativity, community and connection. Connect, share and enjoy with us.
          </p>
        </div>
      </div>

      <!-- Join Discord Button (Button element: hover does NOT show URL in browser corner) -->
      <button type="button"
              class="btn-join-action"
              id="joinDiscordBtn"
              data-invite="<%= typeof discordServerInvite !== 'undefined' ? discordServerInvite : 'https://discord.gg/YzEaab34kV' %>"
              aria-label="Join Sora's Station Discord Server">
        <svg class="btn-join-discord-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        <span>Join Discord</span>
        <svg class="btn-join-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </button>
    </section>

    <!-- RIGHT PANEL: LIVE STATS & PERKS -->
    <aside class="glass-right-panel" aria-label="Live Server Stats">
      <div class="section-eyebrow">Guild Statistics</div>

      <div class="stats-stack">
        <!-- TOTAL MEMBERS -->
        <div class="stat-item-box">
          <div class="stat-badge-icon members" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="rgba(88,101,242,0.95)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div class="stat-data">
            <div class="stat-label-text">Total Members</div>
            <div class="stat-number-value loading" id="statTotalMembers" aria-live="polite">—</div>
          </div>
        </div>

        <!-- ONLINE MEMBERS -->
        <div class="stat-item-box">
          <div class="stat-badge-icon online" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="rgba(34,197,94,0.95)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
          </div>
          <div class="stat-data">
            <div class="stat-label-text">Members Online</div>
            <div class="stat-number-value loading" id="statOnlineMembers" aria-live="polite">
              <span class="online-indicator-dot" aria-hidden="true"></span>
              <span id="statOnlineCount">—</span>
            </div>
          </div>
        </div>
      </div>

      <!-- FEATURES / PERKS -->
      <div class="perks-panel">
        <ul class="perks-list-clean" role="list">
          <li class="perk-item-clean">
            <!-- Uy Tín: Shield Checkmark SVG -->
            <svg class="perk-bullet-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <span>Uy Tín</span>
          </li>
          <li class="perk-item-clean">
            <!-- Giá Rẻ: Value Tag SVG -->
            <svg class="perk-bullet-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
              <circle cx="7" cy="7" r="1.5" fill="currentColor"/>
            </svg>
            <span>Giá Rẻ</span>
          </li>
          <li class="perk-item-clean">
            <!-- Chất Lượng: Premium Star Quality SVG -->
            <svg class="perk-bullet-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span>Chất Lượng</span>
          </li>
        </ul>
      </div>

    </aside>

  </main>

  <!-- Interactive Glass Sheen Tracking -->
  <script>
    (function () {
      "use strict";
      var frame = document.getElementById("discordGlassFrame");
      if (frame && window.matchMedia("(pointer: fine)").matches) {
        frame.addEventListener("mousemove", function (e) {
          var rect = frame.getBoundingClientRect();
          frame.style.setProperty("--mouse-x", (e.clientX - rect.left) + "px");
          frame.style.setProperty("--mouse-y", (e.clientY - rect.top) + "px");
        }, { passive: true });
      }
    })();
  </script>

  <!-- Join Discord Button Handler (No URL reveal on hover) -->
  <script>
    (function () {
      "use strict";
      var button = document.getElementById("joinDiscordBtn");
      if (!button) return;

      button.addEventListener("click", function () {
        var invite = button.getAttribute("data-invite");
        if (!invite) return;
        var opened = window.open(invite, "_blank", "noopener,noreferrer");
        if (!opened) {
          window.location.assign(invite);
        }
      });
    })();
  </script>

  <!-- Realtime Discord Guild Stats Engine (Polling + Easing Counter) -->
  <script>
    (function () {
      "use strict";
      var GUILD_ID = "1463216183712026813";
      var INVITE_CODE = "YzEaab34kV";
      var NORMAL_INTERVAL = 3000;
      var ERROR_INTERVAL = 10000;
      var REQUEST_TIMEOUT = 5000;

      var timer = null;
      var isFetching = false;
      var stopped = false;
      var lastTotal = null;
      var lastOnline = null;
      var isFirstLoad = true;

      var elTotal = document.getElementById("statTotalMembers");
      var elOnlineBox = document.getElementById("statOnlineMembers");
      var elOnlineCount = document.getElementById("statOnlineCount");
      var elIcon = document.getElementById("guildIconImg");

      function fmt(number) {
        if (number === null || number === undefined || Number.isNaN(Number(number))) return "—";
        return Number(number).toLocaleString("en-US");
      }

      function animateElement(element) {
        if (!element) return;
        element.classList.remove("updated");
        void element.offsetWidth; // Force reflow
        element.classList.add("updated");
        setTimeout(function () {
          element.classList.remove("updated");
        }, 400);
      }

      // Smooth count-up easing for first render
      function countUp(element, target, duration) {
        if (!element || typeof target !== "number") return;
        var start = 0;
        var startTime = performance.now();
        function tick(now) {
          var elapsed = now - startTime;
          var progress = Math.min(elapsed / duration, 1);
          var ease = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
          var val = Math.floor(start + (target - start) * ease);
          element.textContent = fmt(val);
          if (progress < 1) {
            requestAnimationFrame(tick);
          } else {
            element.textContent = fmt(target);
          }
        }
        requestAnimationFrame(tick);
      }

      function updateTotal(total) {
        if (total === null || total === undefined) return;
        total = Number(total);
        if (!Number.isFinite(total)) return;

        if (elTotal) {
          elTotal.classList.remove("loading");
          if (lastTotal === null) {
            countUp(elTotal, total, 900);
          } else if (lastTotal !== total) {
            animateElement(elTotal);
            elTotal.textContent = fmt(total);
          }
        }
        lastTotal = total;
      }

      function updateOnline(online) {
        if (online === null || online === undefined) return;
        online = Number(online);
        if (!Number.isFinite(online)) return;

        if (elOnlineBox) {
          elOnlineBox.classList.remove("loading");
        }

        if (elOnlineCount) {
          if (lastOnline === null) {
            countUp(elOnlineCount, online, 800);
          } else if (lastOnline !== online) {
            animateElement(elOnlineBox);
            elOnlineCount.textContent = fmt(online);
          }
        }
        lastOnline = online;
      }

      function updateIcon(iconHash) {
        if (!iconHash || !elIcon) return;
        var newURL = "https://cdn.discordapp.com/icons/" + GUILD_ID + "/" + iconHash + ".webp?size=256";
        if (elIcon.src !== newURL) {
          elIcon.src = newURL;
        }
      }

      async function fetchJSON(url) {
        var controller = new AbortController();
        var timeout = setTimeout(function () {
          controller.abort();
        }, REQUEST_TIMEOUT);

        try {
          var response = await fetch(url, {
            cache: "no-store",
            signal: controller.signal,
            headers: { Accept: "application/json" }
          });
          if (!response.ok) {
            throw new Error("HTTP " + response.status);
          }
          return await response.json();
        } finally {
          clearTimeout(timeout);
        }
      }

      async function fetchInviteStats() {
        var url = "https://discord.com/api/v10/invites/" + encodeURIComponent(INVITE_CODE) + "?with_counts=true&with_expiration=true";
        var data = await fetchJSON(url);
        if (!data) throw new Error("Discord response empty");

        if (data.approximate_member_count !== undefined) {
          updateTotal(data.approximate_member_count);
        }
        if (data.approximate_presence_count !== undefined) {
          updateOnline(data.approximate_presence_count);
        }
        if (data.guild && data.guild.icon) {
          updateIcon(data.guild.icon);
        }
        return true;
      }

      async function fetchVanityStats() {
        var url = "https://discord.com/api/v10/invites/sorasito?with_counts=true";
        var data = await fetchJSON(url);
        if (!data) throw new Error("Vanity response empty");

        if (data.approximate_member_count !== undefined) {
          updateTotal(data.approximate_member_count);
        }
        if (data.approximate_presence_count !== undefined) {
          updateOnline(data.approximate_presence_count);
        }
        if (data.guild && data.guild.icon) {
          updateIcon(data.guild.icon);
        }
        return true;
      }

      async function fetchWidgetOnline() {
        var url = "https://discord.com/api/guilds/" + GUILD_ID + "/widget.json";
        var data = await fetchJSON(url);
        if (data && data.presence_count !== undefined) {
          updateOnline(data.presence_count);
          return true;
        }
        return false;
      }

      function scheduleNext(delay) {
        if (timer) clearTimeout(timer);
        if (stopped) return;
        timer = setTimeout(refreshStats, delay);
      }

      async function refreshStats() {
        if (stopped || isFetching) return;
        if (document.hidden) {
          scheduleNext(NORMAL_INTERVAL);
          return;
        }

        isFetching = true;
        var success = false;

        try {
          await fetchInviteStats();
          success = true;
        } catch (inviteError) {
          try {
            await fetchVanityStats();
            success = true;
          } catch (vanityError) {
            try {
              await fetchWidgetOnline();
              success = true;
            } catch (widgetError) {
              // Graceful: keep last valid counts
            }
          }
        } finally {
          isFetching = false;
          scheduleNext(success ? NORMAL_INTERVAL : ERROR_INTERVAL);
        }
      }

      document.addEventListener("visibilitychange", function () {
        if (!document.hidden) {
          if (timer) clearTimeout(timer);
          refreshStats();
        }
      });

      window.addEventListener("focus", function () {
        if (timer) clearTimeout(timer);
        refreshStats();
      });

      window.addEventListener("pagehide", function () {
        stopped = true;
        if (timer) {
          clearTimeout(timer);
          timer = null;
        }
      });

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", refreshStats, { once: true });
      } else {
        refreshStats();
      }
    })();
  </script>
</body>
</html>
