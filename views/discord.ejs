  <!-- Discord Guild Stats Fetcher (Guild ID: 1463216183712026813) -->
  <script>
  (function () {
    'use strict';
    var GUILD_ID = '1463216183712026813';
    var elTotal = document.getElementById('statTotalMembers');
    var elOnlineBox = document.getElementById('statOnlineMembers');
    var elOnlineCount = document.getElementById('statOnlineCount');
    var elIcon = document.getElementById('guildIconImg');

    function fmt(n) {
      if (n === null || n === undefined || isNaN(n)) return '—';
      return Number(n).toLocaleString('en-US');
    }

    function applyValues(total, online, iconHash) {
      if (elTotal) {
        elTotal.textContent = fmt(total);
        elTotal.classList.remove('loading');
      }
      if (elOnlineCount) {
        elOnlineCount.textContent = fmt(online);
      }
      if (elOnlineBox) {
        elOnlineBox.classList.remove('loading');
      }
      if (iconHash && elIcon) {
        elIcon.src = 'https://cdn.discordapp.com/icons/' + GUILD_ID + '/' + iconHash + '.webp?size=128';
      }
    }

    function fetchStats() {
      // 1. Direct query via verified invite code YzEaab34kV with counts
      fetch('https://discord.com/api/v9/invites/YzEaab34kV?with_counts=true&with_expiration=true', { cache: 'no-store' })
        .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function(data) {
          var total = data.approximate_member_count;
          var online = data.approximate_presence_count;
          var icon = data.guild ? data.guild.icon : null;
          applyValues(total, online, icon);
        })
        .catch(function() {
          // 2. Fallback to vanity URL sorasito
          fetch('https://discord.com/api/v9/invites/sorasito?with_counts=true', { cache: 'no-store' })
            .then(function(r2) { return r2.ok ? r2.json() : Promise.reject(r2.status); })
            .then(function(data2) {
              var total = data2.approximate_member_count;
              var online = data2.approximate_presence_count;
              var icon = data2.guild ? data2.guild.icon : null;
              applyValues(total, online, icon);
            })
            .catch(function() {
              // 3. Fallback to widget.json
              fetch('https://discord.com/api/guilds/' + GUILD_ID + '/widget.json', { cache: 'no-store' })
                .then(function(r3) { return r3.ok ? r3.json() : Promise.reject(r3.status); })
                .then(function(data3) {
                  applyValues(null, data3.presence_count || 50, null);
                })
                .catch(function() {
                  // Fallback numbers from verified guild snapshot if offline
                  applyValues(462, 50, 'c57fd0acb8c421b9d1492465db0eeea5');
                });
            });
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fetchStats);
    } else {
      fetchStats();
    }
  })();
  </script>
