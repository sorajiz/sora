  <!-- Interactive Liquid Sheen Tracking -->
  <script>
    (function () {
      "use strict";
      var frame = document.getElementById("discordGlassFrame");
      if (frame && window.matchMedia("(pointer: fine)").matches) {
        frame.addEventListener("mousemove", function (e) {
          var rect = frame.getBoundingClientRect();
          frame.style.setProperty("--mouse-x", (e.clientX - rect.left) + "px");
          frame.style.setProperty("--mouse-y", (e.clientY - rect.top) + "px");
        }, { passive: true });
      }
    })();
  </script>

  <!-- Join Discord Button Handler (Opens New Tab, NEVER Redirects Current Website) -->
  <script>
    (function () {
      "use strict";
      var button = document.getElementById("joinDiscordBtn");
      if (!button) return;

      button.addEventListener("click", function (event) {
        event.preventDefault();
        event.stopPropagation();
        var invite = button.getAttribute("data-invite") || "https://discord.gg/YzEaab34kV";
        
        var link = document.createElement("a");
        link.href = invite;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.style.display = "none";
        document.body.appendChild(link);
        link.click();
        setTimeout(function () {
          if (link.parentNode) {
            link.parentNode.removeChild(link);
          }
        }, 150);
      });
    })();
  </script>

  <!-- Realtime Discord Guild Stats Engine (Polling + Easing Counter) -->
  <script>
    (function () {
      "use strict";
      var GUILD_ID = "1463216183712026813";
      var INVITE_CODE = "YzEaab34kV";
      var NORMAL_INTERVAL = 3000;
      var ERROR_INTERVAL = 10000;
      var REQUEST_TIMEOUT = 5000;

      var timer = null;
      var isFetching = false;
      var stopped = false;
      var lastTotal = null;
      var lastOnline = null;

      var elTotal = document.getElementById("statTotalMembers");
      var elOnlineBox = document.getElementById("statOnlineMembers");
      var elOnlineCount = document.getElementById("statOnlineCount");
      var elIcon = document.getElementById("guildIconImg");

      function fmt(number) {
        if (number === null || number === undefined || Number.isNaN(Number(number))) return "—";
        return Number(number).toLocaleString("en-US");
      }

      function animateElement(element) {
        if (!element) return;
        element.classList.remove("updated");
        void element.offsetWidth;
        element.classList.add("updated");
        setTimeout(function () {
          element.classList.remove("updated");
        }, 400);
      }

      function countUp(element, target, duration) {
        if (!element || typeof target !== "number") return;
        var start = 0;
        var startTime = performance.now();
        function tick(now) {
          var elapsed = now - startTime;
          var progress = Math.min(elapsed / duration, 1);
          var ease = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
          var val = Math.floor(start + (target - start) * ease);
          element.textContent = fmt(val);
          if (progress < 1) {
            requestAnimationFrame(tick);
          } else {
            element.textContent = fmt(target);
          }
        }
        requestAnimationFrame(tick);
      }

      function updateTotal(total) {
        if (total === null || total === undefined) return;
        total = Number(total);
        if (!Number.isFinite(total)) return;

        if (elTotal) {
          elTotal.classList.remove("loading");
          if (lastTotal === null) {
            countUp(elTotal, total, 900);
          } else if (lastTotal !== total) {
            animateElement(elTotal);
            elTotal.textContent = fmt(total);
          }
        }
        lastTotal = total;
      }

      function updateOnline(online) {
        if (online === null || online === undefined) return;
        online = Number(online);
        if (!Number.isFinite(online)) return;

        if (elOnlineBox) {
          elOnlineBox.classList.remove("loading");
        }

        if (elOnlineCount) {
          if (lastOnline === null) {
            countUp(elOnlineCount, online, 800);
          } else if (lastOnline !== online) {
            animateElement(elOnlineBox);
            elOnlineCount.textContent = fmt(online);
          }
        }
        lastOnline = online;
      }

      function updateIcon(iconHash) {
        if (!iconHash || !elIcon) return;
        var newURL = "https://cdn.discordapp.com/icons/" + GUILD_ID + "/" + iconHash + ".webp?size=256";
        if (elIcon.src !== newURL) {
          elIcon.src = newURL;
        }
      }

      async function fetchJSON(url) {
        var controller = new AbortController();
        var timeout = setTimeout(function () {
          controller.abort();
        }, REQUEST_TIMEOUT);

        try {
          var response = await fetch(url, {
            cache: "no-store",
            signal: controller.signal,
            headers: { Accept: "application/json" }
          });
          if (!response.ok) {
            throw new Error("HTTP " + response.status);
          }
          return await response.json();
        } finally {
          clearTimeout(timeout);
        }
      }

      async function fetchInviteStats() {
        var url = "https://discord.com/api/v10/invites/" + encodeURIComponent(INVITE_CODE) + "?with_counts=true&with_expiration=true";
        var data = await fetchJSON(url);
        if (!data) throw new Error("Discord response empty");

        if (data.approximate_member_count !== undefined) {
          updateTotal(data.approximate_member_count);
        }
        if (data.approximate_presence_count !== undefined) {
          updateOnline(data.approximate_presence_count);
        }
        if (data.guild && data.guild.icon) {
          updateIcon(data.guild.icon);
        }
        return true;
      }

      async function fetchVanityStats() {
        var url = "https://discord.com/api/v10/invites/sorasito?with_counts=true";
        var data = await fetchJSON(url);
        if (!data) throw new Error("Vanity response empty");

        if (data.approximate_member_count !== undefined) {
          updateTotal(data.approximate_member_count);
        }
        if (data.approximate_presence_count !== undefined) {
          updateOnline(data.approximate_presence_count);
        }
        if (data.guild && data.guild.icon) {
          updateIcon(data.guild.icon);
        }
        return true;
      }

      async function fetchWidgetOnline() {
        var url = "https://discord.com/api/guilds/" + GUILD_ID + "/widget.json";
        var data = await fetchJSON(url);
        if (data && data.presence_count !== undefined) {
          updateOnline(data.presence_count);
          return true;
        }
        return false;
      }

      function scheduleNext(delay) {
        if (timer) clearTimeout(timer);
        if (stopped) return;
        timer = setTimeout(refreshStats, delay);
      }

      async function refreshStats() {
        if (isFetching || stopped) return;
        isFetching = true;

        var success = false;
        try {
          success = await fetchInviteStats();
        } catch (e1) {
          try {
            success = await fetchVanityStats();
          } catch (e2) {
            try {
              success = await fetchWidgetOnline();
            } catch (e3) {
              success = false;
            }
          }
        } finally {
          isFetching = false;
        }

        if (success) {
          scheduleNext(NORMAL_INTERVAL);
        } else {
          scheduleNext(ERROR_INTERVAL);
        }
      }

      document.addEventListener("DOMContentLoaded", function () {
        refreshStats();

        document.addEventListener("visibilitychange", function () {
          if (document.hidden) {
            stopped = true;
            if (timer) clearTimeout(timer);
          } else {
            stopped = false;
            refreshStats();
          }
        });
      });
    })();
  </script>

</body>
</html>
