<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= typeof title !== 'undefined' ? title : 'Terms of Service · Pade Store' %></title>
  <meta name="description" content="Nội quy, điều khoản dịch vụ và hướng dẫn sử dụng chính thức tại Pade Community · discord.gg/pade" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#0c0d12" />
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://rules.sorae.tokyo' %>" />

  <!-- Theme bootstrap: resolved before first paint so there is never a flash of the wrong palette. -->
  <script>
    (function () {
      var theme = 'dark';
      try {
        var stored = window.localStorage.getItem('pade-docs-theme');
        if (stored === 'light' || stored === 'dark') {
          theme = stored;
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          theme = 'light';
        }
      } catch (err) { /* storage blocked — stay on the brand default */ }
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>

  <!-- OpenGraph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:site_name" content="Pade Community" />
  <meta property="og:title" content="Pade Community · Rules & ToS & Tutorial" />
  <meta property="og:description" content="Nội quy, điều khoản và tài liệu hướng dẫn Discord Nitro chính thức của Pade Community." />
  <meta property="og:url" content="https://rules.sorae.tokyo" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Pade Community · Rules, ToS & Tutorial" />
  <meta name="twitter:description" content="Nội quy, điều khoản và tài liệu hướng dẫn chính thức của Pade Community." />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="<%= typeof faviconDataUri !== 'undefined' ? faviconDataUri : '/assets/favicon.png' %>" />
  <link rel="shortcut icon" type="image/png" href="/assets/favicon.png" />

  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* ── RESET & DARK GRAY DESIGN SYSTEM ── */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --bg-base: #0c0d12;
      --bg-surface: #13141a;
      --bg-surface-elevated: #181922;
      --bg-sidebar-pill: #21232d;
      --bg-badge: #1b1c24;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.16);
      --border-focus: rgba(255, 255, 255, 0.28);
      --text-white: #ffffff;
      --text-main: #f1f2f6;
      --text-sub: #c5c8d4;
      --text-muted: #838896;
      --text-dim: #5c606e;
      --accent-amber: #f59e0b;
      --accent-amber-bg: #1c160c;
      --accent-amber-border: rgba(245, 158, 11, 0.35);
      --accent-blue: #38bdf8;
      --accent-red: #ef4444;
      --accent-green: #22c55e;
      --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: "JetBrains Mono", monospace;
      /* Sticky offsets — updated at runtime from the real header height. */
      --header-h: 68px;
      --chips-h: 56px;
      --page-pad: clamp(0.9rem, 3.4vw, 1.5rem);
      color-scheme: dark;
    }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }

    body {
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      min-height: 100dvh;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
      overflow-wrap: break-word;
      position: relative;
    }

    /* Keyboard focus is always visible, mouse clicks stay clean. */
    a:focus-visible,
    button:focus-visible {
      outline: 2px solid var(--accent-blue);
      outline-offset: 3px;
      border-radius: 8px;
    }

    .ambient-mesh {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle at 15% 15%, rgba(33, 35, 45, 0.4) 0%, transparent 60%),
                  radial-gradient(circle at 85% 85%, rgba(20, 21, 28, 0.6) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    .reading-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 100%;
      background: linear-gradient(90deg, #5865f2, #38bdf8, #a855f7);
      transform-origin: 0% 50%;
      transform: scaleX(0);
      z-index: 100;
      transition: transform 0.08s ease-out;
    }

    /* ── HEADER / TOPBAR ── */
    .top-header {
      position: sticky;
      top: 0;
      width: 100%;
      z-index: 50;
      background: rgba(12, 13, 18, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-subtle);
      padding-top: env(safe-area-inset-top, 0px);
    }

    .top-header-inner {
      max-width: 1260px;
      margin: 0 auto;
      padding: 0.85rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      min-width: 0;
    }

    .header-brand-wrap {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: inherit;
    }

    .brand-avatar {
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      overflow: hidden;
      border: 1px solid var(--border-strong);
      background: #181920;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .brand-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .brand-name {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text-white);
      letter-spacing: -0.02em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* ── SLIDING TABS IN HEADER (ẢNH 1 - DI CHUYỂN MƯỢT MÀ KHI NHẤN) ── */
    .nav-tabs-wrapper {
      position: relative;
      display: inline-flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid var(--border-subtle);
      border-radius: 9999px;
      padding: 4px;
      user-select: none;
      max-width: 100%;
      min-width: 0;
      flex-shrink: 0;
    }

    .nav-pill-slider {
      position: absolute;
      top: 4px;
      bottom: 4px;
      left: 4px;
      width: 0;
      background: var(--bg-sidebar-pill);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 9999px;
      transition: left 0.28s cubic-bezier(0.16, 1, 0.3, 1), width 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
      z-index: 1;
    }

    .nav-tab-link {
      position: relative;
      z-index: 2;
      padding: 0.45rem 1.15rem;
      min-height: 36px;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      border-radius: 9999px;
      transition: color 0.18s ease;
      white-space: nowrap;
      cursor: pointer;
      border: none;
      background: transparent;
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-width: 0;
    }

    .nav-tab-link.active {
      color: var(--text-white);
      font-weight: 700;
    }

    .nav-tab-link:hover {
      color: var(--text-white);
    }

    .tab-label-short {
      display: none;
    }

    .mobile-menu-btn {
      display: none;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 0.45rem 0.65rem;
      border-radius: 0.5rem;
      cursor: pointer;
      font-size: 0.8125rem;
      font-weight: 600;
      align-items: center;
      gap: 0.4rem;
    }

    /* ── MAIN CONTENT LAYOUT ── */
    .layout-wrapper {
      position: relative;
      z-index: 10;
      max-width: 1260px;
      margin: 0 auto;
      padding: 2.5rem clamp(1rem, 4vw, 1.5rem) 6rem;
      display: flex;
      align-items: flex-start;
      gap: 3.5rem;
      min-width: 0;
    }

    /* ── LEFT SIDEBAR ── */
    .sidebar {
      width: 270px;
      flex-shrink: 0;
      position: sticky;
      top: calc(var(--header-h) + 1.25rem);
      max-height: calc(100dvh - var(--header-h) - 2.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-right: 0.5rem;
      scrollbar-width: thin;
      scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
    }

    .sidebar::-webkit-scrollbar {
      width: 6px;
    }

    .sidebar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.18);
      border-radius: 999px;
    }

    .sidebar-panel-view {
      display: none;
    }

    .sidebar-panel-view.active {
      display: block;
      animation: fadeIn 0.22s ease-out forwards;
    }

    .sidebar-group {
      margin-bottom: 2rem;
    }

    .sidebar-heading {
      font-size: 0.6875rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 0.75rem;
      padding: 0 0.75rem;
    }

    .sidebar-nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .sidebar-nav-link {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.5rem 0.75rem;
      min-height: 40px;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-muted);
      text-decoration: none;
      transition: all 0.15s ease;
    }

    .sidebar-nav-link:hover {
      color: var(--text-white);
      background: rgba(255, 255, 255, 0.04);
    }

    .sidebar-nav-link.active {
      background: var(--bg-sidebar-pill);
      color: var(--text-white);
      font-weight: 600;
    }

    .sidebar-nav-link .nav-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--text-dim);
      flex-shrink: 0;
      transition: all 0.15s ease;
    }

    .sidebar-nav-link.active .nav-dot {
      background: var(--text-white);
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
    }

    /* ── RIGHT MAIN ARTICLE AREA ── */
    .main-content {
      flex: 1;
      min-width: 0;
      width: 100%;
      max-width: 820px;
    }

    .tab-panel-view {
      display: none;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.22s ease, transform 0.22s ease;
    }

    .tab-panel-view.active {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .content-eyebrow {
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      display: block;
      margin-bottom: 0.5rem;
    }

    .hero-title {
      font-size: clamp(1.65rem, 5.2vw, 2.75rem);
      font-weight: 900;
      color: var(--text-white);
      letter-spacing: -0.035em;
      line-height: 1.15;
      margin-bottom: 1rem;
      overflow-wrap: anywhere;
    }

    /* Meta Badge with SVG Icon */
    .meta-badge {
      display: inline-flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      max-width: 100%;
      padding: 0.35rem 0.85rem;
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid var(--border-subtle);
      border-radius: 9999px;
      font-size: 0.75rem;
      color: var(--text-sub);
      margin-bottom: 2rem;
      overflow-wrap: anywhere;
    }

    .meta-icon-svg {
      display: inline-flex;
      align-items: center;
      color: var(--text-muted);
    }

    .meta-badge-link {
      color: var(--text-white);
      font-weight: 700;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .meta-badge-link:hover {
      text-decoration: underline;
      color: var(--accent-blue);
    }

    .section-divider {
      border: 0;
      border-top: 1px solid var(--border-subtle);
      margin: 2.25rem 0;
    }

    .tos-section {
      scroll-margin-top: calc(var(--header-h) + 1.5rem);
      position: relative;
      min-width: 0;
    }

    .section-header-row {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      margin-bottom: 1rem;
      min-width: 0;
    }

    .number-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      background: var(--bg-badge);
      border: 1px solid var(--border-subtle);
      border-radius: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      font-weight: 700;
      color: var(--text-muted);
      flex-shrink: 0;
    }

    .section-title {
      font-size: clamp(1.12rem, 3.6vw, 1.35rem);
      font-weight: 800;
      color: var(--text-white);
      letter-spacing: -0.015em;
      line-height: 1.3;
      min-width: 0;
      overflow-wrap: anywhere;
      padding-top: 0.2rem;
    }

    .section-anchor-btn {
      opacity: 0;
      color: var(--text-dim);
      text-decoration: none;
      font-size: 1.1rem;
      line-height: 1;
      margin-left: 0.35rem;
      padding: 0.3rem;
      border-radius: 6px;
      transition: all 0.15s ease;
      flex-shrink: 0;
    }

    .tos-section:hover .section-anchor-btn {
      opacity: 1;
    }

    .rules-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      margin: 0.85rem 0;
    }

    .rules-list-item {
      position: relative;
      padding-left: 1.25rem;
      font-size: 0.9375rem;
      color: var(--text-main);
      line-height: 1.65;
      overflow-wrap: anywhere;
      min-width: 0;
    }

    .rules-list-item::before {
      content: "•";
      position: absolute;
      left: 0.25rem;
      color: var(--text-dim);
      font-weight: bold;
    }

    .rules-list-item strong {
      color: var(--text-white);
    }

    /* Rule Card with Clean SVG Icon */
    .rule-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 0.85rem;
      padding: 1.25rem 1.35rem;
      margin: 1rem 0;
      transition: border-color 0.15s ease;
      min-width: 0;
    }

    .rule-card:hover {
      border-color: var(--border-strong);
    }

    .rule-card-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-white);
      margin-bottom: 0.75rem;
      display: flex;
      align-items: flex-start;
      gap: 0.55rem;
      line-height: 1.45;
      overflow-wrap: anywhere;
    }

    .icon-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.65rem;
      height: 1.65rem;
      border-radius: 0.4rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      flex-shrink: 0;
    }

    .icon-badge.text-cyan { color: #38bdf8; background: rgba(56, 189, 248, 0.08); border-color: rgba(56, 189, 248, 0.2); }
    .icon-badge.text-purple { color: #c084fc; background: rgba(192, 132, 252, 0.08); border-color: rgba(192, 132, 252, 0.2); }
    .icon-badge.text-amber { color: #f59e0b; background: rgba(245, 158, 11, 0.08); border-color: rgba(245, 158, 11, 0.2); }
    .icon-badge.text-pink { color: #f472b6; background: rgba(244, 114, 182, 0.08); border-color: rgba(244, 114, 182, 0.2); }
    .icon-badge.text-yellow { color: #facc15; background: rgba(250, 204, 21, 0.08); border-color: rgba(250, 204, 21, 0.2); }
    .icon-badge.text-blue { color: #60a5fa; background: rgba(96, 165, 250, 0.08); border-color: rgba(96, 165, 250, 0.2); }
    .icon-badge.text-green { color: #22c55e; background: rgba(34, 197, 94, 0.08); border-color: rgba(34, 197, 94, 0.2); }
    .icon-badge.text-red { color: #ef4444; background: rgba(239, 68, 68, 0.08); border-color: rgba(239, 68, 68, 0.2); }

    .callout-box {
      background: var(--accent-amber-bg);
      border: 1px solid var(--accent-amber-border);
      border-left: 4px solid var(--accent-amber);
      border-radius: 0.65rem;
      padding: 0.95rem 1.25rem;
      margin: 1.15rem 0;
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      min-width: 0;
    }

    .callout-icon {
      color: var(--accent-amber);
      flex-shrink: 0;
      margin-top: 0.15rem;
    }

    .callout-content {
      font-size: 0.9rem;
      font-weight: 600;
      color: #fef3c7;
      line-height: 1.55;
      min-width: 0;
      overflow-wrap: anywhere;
    }

    /* Formula Box for Refund Calculation */
    .formula-box {
      background: #10121a;
      border: 1px solid rgba(56, 189, 248, 0.25);
      border-radius: 0.75rem;
      padding: 1.15rem 1.35rem;
      margin: 1rem 0;
    }

    .formula-title {
      font-size: 0.8125rem;
      font-weight: 700;
      color: #38bdf8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .formula-code {
      font-family: var(--font-mono);
      font-size: 0.925rem;
      font-weight: 700;
      color: #fff;
      background: rgba(0, 0, 0, 0.4);
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      white-space: nowrap;
      max-width: 100%;
    }

    .feedback-channel-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.35rem 0.75rem;
      background: rgba(88, 101, 242, 0.15);
      border: 1px solid rgba(88, 101, 242, 0.35);
      border-radius: 0.45rem;
      color: #85b0ff;
      font-size: 0.8125rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.15s ease;
      margin: 0.25rem 0;
    }

    .feedback-channel-badge:hover {
      background: rgba(88, 101, 242, 0.25);
      color: #fff;
      border-color: rgba(88, 101, 242, 0.6);
      transform: translateY(-1px);
    }

    .promo-checker-box {
      background: linear-gradient(135deg, #181922 0%, #13141a 100%);
      border: 1px solid var(--border-strong);
      border-radius: 0.85rem;
      padding: 1.35rem 1.5rem;
      margin: 1.25rem 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      min-width: 0;
    }

    .promo-link-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 42px;
      padding: 0.65rem 1.25rem;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 0.5rem;
      color: #fff;
      font-size: 0.8125rem;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
      transition: all 0.18s ease;
      align-self: flex-start;
      max-width: 100%;
    }

    .promo-link-btn:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
      transform: translateY(-1px);
    }

    .video-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      height: auto;
      border-radius: 0.85rem;
      overflow: hidden;
      border: 1px solid var(--border-strong);
      background: #111218;
      margin: 1.25rem 0;
    }

    .video-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .site-footer {
      border-top: 1px solid var(--border-subtle);
      background: #090a0d;
      padding: 3rem clamp(1rem, 4vw, 1.5rem);
      padding-bottom: calc(3rem + env(safe-area-inset-bottom, 0px));
      color: var(--text-muted);
      font-size: 0.8125rem;
    }

    .footer-inner {
      max-width: 1260px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      min-width: 0;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 1.5rem;
      list-style: none;
      padding: 0;
    }

    .footer-link {
      color: var(--text-sub);
      text-decoration: none;
      transition: color 0.15s ease;
      display: inline-flex;
      align-items: center;
      min-height: 32px;
    }

    .footer-link:hover {
      color: var(--text-white);
    }

    .toast {
      position: fixed;
      bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
      right: calc(2rem + env(safe-area-inset-right, 0px));
      max-width: calc(100vw - 2rem);
      background: #1c1d26;
      border: 1px solid var(--border-strong);
      color: var(--text-white);
      padding: 0.75rem 1.25rem;
      border-radius: 0.55rem;
      font-size: 0.875rem;
      font-weight: 600;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
      z-index: 1000;
      transform: translateY(100px);
      opacity: 0;
      pointer-events: none;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* ── BACK TO TOP (long reading pages on touch devices) ── */
    .back-to-top {
      position: fixed;
      right: calc(1.1rem + env(safe-area-inset-right, 0px));
      bottom: calc(1.1rem + env(safe-area-inset-bottom, 0px));
      width: 44px;
      height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(28, 29, 38, 0.92);
      border: 1px solid var(--border-strong);
      color: var(--text-white);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      cursor: pointer;
      z-index: 90;
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px) scale(0.92);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    }

    .back-to-top.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }

    .back-to-top:active {
      transform: scale(0.94);
    }

    /* ── MOBILE / TABLET SECTION CHIPS BAR ── */
    .mobile-category-bar {
      display: none;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      gap: 0.5rem;
      padding: 0.55rem 0.25rem 0.65rem;
      margin: -0.35rem 0 1.35rem 0;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 0.25rem;
      overscroll-behavior-x: contain;
      touch-action: pan-x;
      position: sticky;
      top: var(--header-h);
      z-index: 40;
      background: rgba(12, 13, 18, 0.97);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .mobile-category-bar::-webkit-scrollbar {
      display: none;
    }

    .mobile-cat-pill {
      background: #13141a;
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: var(--text-sub);
      padding: 0.45rem 0.85rem;
      min-height: 38px;
      border-radius: 9999px;
      font-size: 0.78125rem;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      text-decoration: none;
      flex-shrink: 0;
      scroll-snap-align: center;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mobile-cat-pill:active {
      transform: scale(0.96);
    }
    .mobile-cat-pill.active {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.14), rgba(201, 204, 210, 0.05));
      border-color: rgba(201, 204, 210, 0.45);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }

    .header-discord-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.35rem 0.75rem;
      background: rgba(88, 101, 242, 0.15);
      border: 1px solid rgba(88, 101, 242, 0.35);
      border-radius: 9999px;
      color: #85b0ff;
      font-size: 0.75rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.18s ease;
    }
    .header-discord-badge:hover {
      background: rgba(88, 101, 242, 0.28);
      color: #fff;
      border-color: rgba(88, 101, 242, 0.6);
    }

    /* ── RESPONSIVE: LARGE TABLET / SMALL LAPTOP ── */
    @media (max-width: 1180px) {
      .layout-wrapper {
        gap: 2.5rem;
      }
      .sidebar {
        width: 240px;
      }
    }

    /* ── RESPONSIVE: TABLET PORTRAIT & BELOW — sidebar collapses to chips ── */
    @media (max-width: 1024px) {
      .sidebar {
        display: none !important;
      }
      .mobile-menu-btn {
        display: none !important;
      }
      .mobile-category-bar {
        display: flex !important;
      }
      .layout-wrapper {
        flex-direction: column;
        align-items: stretch;
        max-width: 880px;
        padding: 1rem calc(var(--page-pad) + env(safe-area-inset-right, 0px)) 4.5rem calc(var(--page-pad) + env(safe-area-inset-left, 0px));
        gap: 0;
      }
      .main-content {
        max-width: 100%;
        width: 100%;
      }
      .mobile-category-bar {
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 0.85rem;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
      }
      .tos-section {
        scroll-margin-top: calc(var(--header-h) + var(--chips-h) + 0.75rem);
      }
    }

    /* ── RESPONSIVE: PHONE / SMALL TABLET HEADER ── */
    @media (max-width: 900px) {
      .top-header {
        padding: 0.5rem clamp(0.7rem, 3vw, 0.85rem);
      }
      .top-header-inner {
        flex-direction: column;
        align-items: stretch;
        gap: 0.5rem;
        padding: 0;
      }
      .header-brand-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        width: 100%;
        min-width: 0;
      }
      .nav-tabs-wrapper {
        width: 100%;
        display: flex;
        justify-content: space-between;
        padding: 3px;
        box-sizing: border-box;
      }
      .nav-tab-link {
        flex: 1 1 0;
        text-align: center;
        padding: 0.38rem 0.35rem;
        font-size: 0.75rem;
        min-height: 38px;
      }
      .nav-pill-slider {
        top: 3px;
        bottom: 3px;
      }
      .rule-card {
        padding: 1rem;
        border-radius: 0.75rem;
      }
      .callout-box {
        padding: 1rem;
        border-radius: 0.75rem;
      }
      .rules-list {
        gap: 0.5rem;
      }
      .rules-list-item {
        font-size: 0.875rem;
        line-height: 1.6;
      }
    }

    /* ── RESPONSIVE: PHONE ── */
    @media (max-width: 640px) {
      .brand-name {
        font-size: 0.95rem;
      }
      .brand-avatar {
        width: 2rem;
        height: 2rem;
      }
      .brand-group {
        gap: 0.55rem;
      }
      .header-discord-badge {
        padding: 0.32rem 0.6rem;
      }
      .header-discord-badge span {
        font-size: 0.7rem;
      }
      .content-eyebrow {
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
      }
      .hero-title {
        margin-bottom: 0.75rem;
      }
      .meta-badge {
        font-size: 0.7rem;
        padding: 0.35rem 0.7rem;
        margin-bottom: 1.5rem;
        border-radius: 0.85rem;
        line-height: 1.45;
      }
      .section-divider {
        margin: 1.75rem 0;
      }
      .section-header-row {
        gap: 0.65rem;
      }
      .number-badge {
        width: 2rem;
        height: 2rem;
        font-size: 0.75rem;
        border-radius: 0.45rem;
      }
      .rule-card {
        padding: 0.95rem;
        margin: 0.85rem 0;
      }
      .rule-card-title {
        font-size: 0.9rem;
      }
      .callout-box {
        padding: 0.85rem 0.9rem;
        gap: 0.6rem;
      }
      .callout-content {
        font-size: 0.84rem;
      }
      .promo-checker-box {
        padding: 1rem;
      }
      .promo-link-btn {
        align-self: stretch;
        width: 100%;
      }
      .mobile-cat-pill {
        font-size: 0.75rem;
        padding: 0.4rem 0.75rem;
      }
      .footer-inner {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }
      .footer-links {
        gap: 0.5rem 1.1rem;
      }
      .toast {
        left: calc(1rem + env(safe-area-inset-left, 0px));
        right: calc(1rem + env(safe-area-inset-right, 0px));
        bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px));
        max-width: none;
        text-align: center;
      }
    }

    /* ── RESPONSIVE: VERY NARROW PHONES ── */
    @media (max-width: 480px) {
      .tab-label-full {
        display: none;
      }
      .tab-label-short {
        display: inline;
      }
      .nav-tab-link {
        padding: 0.38rem 0.2rem;
        font-size: 0.72rem;
        letter-spacing: -0.01em;
      }
      .header-discord-badge span {
        display: none;
      }
      .header-discord-badge {
        padding: 0.42rem;
        border-radius: 50%;
      }
      .meta-badge {
        display: flex;
        width: 100%;
      }
    }

    @media (max-width: 380px) {
      :root {
        --page-pad: 0.7rem;
      }
      .nav-tab-link {
        font-size: 0.66rem;
      }
      .mobile-cat-pill {
        font-size: 0.7rem;
        padding: 0.38rem 0.65rem;
      }
      .rules-list-item {
        font-size: 0.84rem;
      }
    }

    /* ── TOUCH DEVICES: section anchors are always reachable ── */
    @media (hover: none), (pointer: coarse) {
      .section-anchor-btn {
        opacity: 0.55;
      }
      .tos-section:hover .section-anchor-btn {
        opacity: 0.55;
      }
    }

    /* ── RESPECT USERS WHO PREFER LESS MOTION ── */
    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
      .nav-pill-slider {
        transition: none !important;
      }
    }
    /* ══════════════════════════════════════════════════════════════════
       PADE · SILVER CHROME DOCS LAYER
       Palette discipline: void / graphite / silver.
       No neon, no RGB light shows, no purple SaaS gradients.
       ══════════════════════════════════════════════════════════════════ */
    :root {
      --void: #050506;
      --ink: #0b0b0e;
      --graphite: #131317;
      --steel: #1c1c22;
      --elevated: #212128;
      --line: #2a2a32;
      --line-soft: rgba(255, 255, 255, 0.06);
      --line-strong: rgba(255, 255, 255, 0.14);
      --white: #fbfbfd;
      --off-white: #edeef2;
      --text-2: #b8b9c2;
      --ash: #85868f;
      --silver-accent: #d0d3d9;
      --silver-dim: #9a9da5;
      --silver-deep: #6a6d75;
      --glow-soft: rgba(208, 211, 217, 0.1);
      --glow-mid: rgba(208, 211, 217, 0.18);
      --glow-strong: rgba(255, 255, 255, 0.3);
      --shadow-deep: 0 26px 64px -30px rgba(0, 0, 0, 0.95);
      --grad-silver: linear-gradient(180deg, #ffffff 0%, #e7e8ec 44%, #a7aab2 100%);
      --grad-panel: linear-gradient(180deg, rgba(24, 24, 30, 0.92) 0%, rgba(11, 11, 14, 0.96) 100%);
      --grad-line: linear-gradient(120deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.02) 42%, rgba(208, 211, 217, 0.16) 100%);
      --ease-out-quint: cubic-bezier(0.16, 1, 0.3, 1);
      --font-display: "Outfit", "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;

      /* Legacy aliases — the original sheet now inherits the brand palette. */
      --bg-base: var(--void);
      --bg-surface: var(--ink);
      --bg-surface-elevated: var(--graphite);
      --bg-sidebar-pill: var(--steel);
      --bg-badge: var(--graphite);
      --border-subtle: var(--line-soft);
      --border-strong: var(--line-strong);
      --border-focus: rgba(208, 211, 217, 0.5);
      --text-white: var(--white);
      --text-main: var(--off-white);
      --text-sub: var(--text-2);
      --text-muted: var(--ash);
      --text-dim: #5c5f68;
      --accent-amber: #d9b877;
      --accent-amber-bg: rgba(217, 184, 119, 0.06);
      --accent-amber-border: rgba(217, 184, 119, 0.22);
      --accent-blue: var(--silver-dim);
      --accent-red: #d98d8d;
      --accent-green: #9ed3b4;
    }

    body {
      background-color: var(--void);
      color: var(--off-white);
      text-rendering: optimizeLegibility;
    }

    ::selection {
      background: rgba(208, 211, 217, 0.24);
      color: #ffffff;
    }

    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: var(--void);
    }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, var(--steel), var(--line));
      border-radius: 9999px;
      border: 2px solid var(--void);
    }
    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, var(--line), var(--silver-deep));
    }

    /* ── AMBIENT: static silver wash, no full-page blur ── */
    .ambient-mesh {
      background:
        radial-gradient(ellipse 90% 60% at 50% -15%, rgba(208, 211, 217, 0.1), transparent 70%),
        radial-gradient(circle at 82% 22%, rgba(255, 255, 255, 0.03), transparent 45%),
        radial-gradient(circle at 12% 62%, rgba(154, 157, 165, 0.05), transparent 48%);
    }

    .reading-progress {
      height: 2px;
      background: linear-gradient(90deg, rgba(208, 211, 217, 0) 0%, var(--silver-dim) 55%, #ffffff 100%);
      box-shadow: 0 0 12px rgba(208, 211, 217, 0.35);
    }

    /* ── SKIP LINK ── */
    .skip-link {
      position: fixed;
      top: -80px;
      left: 1rem;
      z-index: 200;
      padding: 0.6rem 0.9rem;
      border-radius: 0.6rem;
      background: var(--grad-silver);
      color: var(--void);
      font-size: 0.8125rem;
      font-weight: 700;
      text-decoration: none;
      transition: top 0.2s var(--ease-out-quint);
    }
    .skip-link:focus {
      top: calc(0.75rem + env(safe-area-inset-top, 0px));
    }

    /* ── HEADER ── */
    .top-header {
      background: linear-gradient(180deg, rgba(13, 13, 17, 0.9) 0%, rgba(8, 8, 11, 0.94) 100%);
      border-bottom: 1px solid var(--line-soft);
    }
    .top-header::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 1px;
      background: var(--grad-line);
      opacity: 0.6;
      pointer-events: none;
    }

    .brand-group {
      gap: 0.8rem;
      min-width: 0;
    }

    .brand-mark {
      width: 2.4rem;
      height: 2.4rem;
      padding: 2px;
      border-radius: 50%;
      background: var(--grad-line);
      box-shadow: 0 10px 26px -16px rgba(0, 0, 0, 0.95);
      flex-shrink: 0;
    }
    .brand-mark img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid rgba(0, 0, 0, 0.6);
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      min-width: 0;
      line-height: 1.05;
    }
    .brand-name {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      background: var(--grad-silver);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
    .brand-sub {
      font-size: 0.5625rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--silver-deep);
      white-space: nowrap;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-left: auto;
      flex-shrink: 0;
    }

    .icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      height: 2.35rem;
      min-width: 2.35rem;
      padding: 0 0.65rem;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--line-soft);
      color: var(--silver-dim);
      font-family: inherit;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
    }
    .icon-btn:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.06);
      border-color: var(--line-strong);
    }
    .icon-btn kbd {
      font-family: var(--font-mono);
      font-size: 0.625rem;
      padding: 0.1rem 0.3rem;
      border-radius: 4px;
      border: 1px solid var(--line);
      background: rgba(0, 0, 0, 0.35);
      color: var(--silver-deep);
    }

    .header-discord-badge {
      background: rgba(255, 255, 255, 0.03);
      border-color: var(--line-soft);
      color: var(--silver-accent);
      min-height: 2.35rem;
    }
    .header-discord-badge:hover {
      background: rgba(255, 255, 255, 0.07);
      border-color: var(--line-strong);
      color: #ffffff;
    }

    /* ── NAV TABS: silver slider ── */
    .nav-tabs-wrapper {
      background: rgba(255, 255, 255, 0.03);
      border-color: var(--line-soft);
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
    }
    .nav-pill-slider {
      background: var(--grad-silver);
      border: 1px solid rgba(255, 255, 255, 0.55);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.7) inset,
        0 8px 20px -12px rgba(208, 211, 217, 0.55);
    }
    .nav-tab-link {
      letter-spacing: 0.01em;
    }
    .nav-tabs-wrapper.has-slider .nav-tab-link.active {
      color: var(--void);
      font-weight: 700;
    }

    /* ── HERO ── */
    .doc-hero {
      position: relative;
      padding-top: 0.15rem;
      min-width: 0;
    }
    .doc-hero::before {
      content: "";
      position: absolute;
      top: -2.5rem;
      left: -1.5rem;
      width: 22rem;
      height: 14rem;
      max-width: 100%;
      background: radial-gradient(ellipse at 30% 40%, rgba(208, 211, 217, 0.08), transparent 68%);
      pointer-events: none;
      z-index: -1;
    }
    .doc-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.95rem;
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--silver-dim);
    }
    .doc-kicker::before {
      content: "";
      width: 22px;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--silver-dim));
    }
    .doc-title {
      margin: 0 0 0.9rem;
      font-family: var(--font-display);
      font-size: clamp(2rem, 5.2vw, 3.15rem);
      font-weight: 800;
      line-height: 1.03;
      letter-spacing: -0.04em;
      background: linear-gradient(180deg, #ffffff 0%, #e9eaee 46%, #a9acb4 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      overflow-wrap: anywhere;
    }
    .doc-lead {
      max-width: 62ch;
      margin: 0 0 1.35rem;
      color: var(--text-2);
      font-size: 0.96rem;
      line-height: 1.7;
    }
    .doc-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.8rem;
      margin-bottom: 1.5rem;
      color: var(--ash);
      font-size: 0.75rem;
    }
    .doc-meta__item {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .doc-meta__item svg {
      color: var(--silver-deep);
      flex-shrink: 0;
    }
    .doc-meta__sep {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--silver-deep);
    }
    .doc-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      margin-bottom: 0.35rem;
    }

    /* ── CONTROLS ── */
    .pade-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 40px;
      padding: 0.55rem 1rem;
      border-radius: 0.7rem;
      border: 1px solid transparent;
      font-family: inherit;
      font-size: 0.8125rem;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      transition: transform 0.2s var(--ease-out-quint), box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
    }
    .pade-btn:active {
      transform: scale(0.97);
    }
    .pade-btn-primary {
      background: var(--grad-silver);
      color: var(--void);
      border-color: rgba(255, 255, 255, 0.6);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.7) inset,
        0 10px 26px -14px rgba(208, 211, 217, 0.5);
    }
    .pade-btn-primary:hover {
      transform: translateY(-1px);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.85) inset,
        0 14px 30px -14px rgba(208, 211, 217, 0.6);
    }
    .pade-btn-ghost {
      background: rgba(255, 255, 255, 0.03);
      border-color: var(--line-soft);
      color: var(--off-white);
    }
    .pade-btn-ghost:hover {
      transform: translateY(-1px);
      background: rgba(255, 255, 255, 0.06);
      border-color: var(--line-strong);
      color: #ffffff;
    }
    .pade-btn kbd {
      font-family: var(--font-mono);
      font-size: 0.625rem;
      padding: 0.1rem 0.32rem;
      border-radius: 4px;
      border: 1px solid rgba(0, 0, 0, 0.35);
      background: rgba(0, 0, 0, 0.08);
      color: inherit;
      opacity: 0.7;
    }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 286px;
    }
    .sidebar-progress {
      height: 2px;
      margin: 0 0.75rem 1.1rem;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.06);
      overflow: hidden;
    }
    .sidebar-progress span {
      display: block;
      width: 0;
      height: 100%;
      background: var(--grad-silver);
      transition: width 0.12s linear;
    }
    .sidebar-heading {
      color: var(--silver-deep);
      font-size: 0.625rem;
      letter-spacing: 0.16em;
    }
    .sidebar-nav-link {
      position: relative;
      color: var(--ash);
      border: 1px solid transparent;
      border-radius: 0.6rem;
    }
    .sidebar-nav-link::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      width: 2px;
      height: 18px;
      border-radius: 2px;
      background: var(--grad-silver);
      opacity: 0;
      transform: translateY(-50%) scaleY(0.3);
      transition: opacity 0.2s ease, transform 0.25s var(--ease-out-quint);
    }
    .sidebar-nav-link:hover {
      color: var(--off-white);
      background: rgba(255, 255, 255, 0.035);
    }
    .sidebar-nav-link.active {
      color: #ffffff;
      background: linear-gradient(180deg, rgba(33, 33, 40, 0.9) 0%, rgba(19, 19, 23, 0.9) 100%);
      border-color: var(--line-soft);
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset;
    }
    .sidebar-nav-link.active::before {
      opacity: 1;
      transform: translateY(-50%) scaleY(1);
    }
    .sidebar-nav-link .nav-dot {
      background: var(--silver-deep);
    }
    .sidebar-nav-link.active .nav-dot {
      background: #ffffff;
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
    }

    /* ── SECTIONS ── */
    .section-divider {
      border-top: 1px solid transparent;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.14) 22%, rgba(208, 211, 217, 0.28) 50%, rgba(255, 255, 255, 0.14) 78%, transparent);
      opacity: 0.55;
      margin: 2.5rem 0;
    }
    .number-badge {
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 0.65rem;
      background: linear-gradient(180deg, rgba(28, 28, 34, 0.92) 0%, rgba(11, 11, 14, 0.92) 100%);
      border-color: var(--line);
      color: var(--silver-dim);
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset;
    }
    .section-title {
      font-family: var(--font-display);
      font-weight: 700;
      letter-spacing: -0.022em;
    }
    .section-anchor-btn {
      color: var(--silver-deep);
      border-radius: 6px;
    }
    .section-anchor-btn:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.05);
    }

    .rules-list {
      gap: 0.7rem;
    }
    .rules-list-item {
      padding-left: 1.35rem;
      color: var(--text-2);
    }
    .rules-list-item::before {
      content: "";
      top: 0.62em;
      left: 0.25rem;
      width: 5px;
      height: 5px;
      border-radius: 1.5px;
      background: var(--silver-deep);
      transform: rotate(45deg);
    }
    .rules-list-item strong {
      color: #ffffff;
      font-weight: 700;
    }

    /* ── CARDS: gradient hairline + pointer spotlight ── */
    .rule-card {
      position: relative;
      overflow: hidden;
      padding: 1.35rem 1.5rem;
      border-radius: 1rem;
      border: 1px solid transparent;
      background: var(--grad-panel) padding-box, var(--grad-line) border-box;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.02) inset,
        0 10px 30px -24px rgba(0, 0, 0, 0.9);
      transition: transform 0.32s var(--ease-out-quint), box-shadow 0.32s ease, background 0.32s ease;
    }
    .rule-card::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 0%), rgba(255, 255, 255, 0.08), transparent 62%);
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }
    @media (hover: hover) and (pointer: fine) {
      .rule-card:hover {
        transform: translateY(-3px);
        background:
          linear-gradient(180deg, rgba(30, 30, 37, 0.96) 0%, rgba(14, 14, 18, 0.98) 100%) padding-box,
          linear-gradient(120deg, rgba(255, 255, 255, 0.3) 0%, rgba(208, 211, 217, 0.14) 48%, rgba(255, 255, 255, 0.26) 100%) border-box;
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.04) inset,
          var(--shadow-deep),
          0 0 34px -14px var(--glow-mid);
      }
      .rule-card:hover::before {
        opacity: 1;
      }
    }
    .rule-card-title {
      gap: 0.7rem;
      font-size: 0.975rem;
    }
    .icon-badge {
      width: 2rem;
      height: 2rem;
      border-radius: 0.55rem;
      background: linear-gradient(180deg, rgba(33, 33, 40, 0.95) 0%, rgba(15, 15, 19, 0.95) 100%);
      border-color: var(--line);
      color: var(--silver-accent);
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
    }
    .icon-badge.text-cyan,
    .icon-badge.text-purple,
    .icon-badge.text-amber,
    .icon-badge.text-pink,
    .icon-badge.text-yellow,
    .icon-badge.text-blue,
    .icon-badge.text-green,
    .icon-badge.text-red {
      color: var(--silver-accent);
      background: linear-gradient(180deg, rgba(33, 33, 40, 0.95) 0%, rgba(15, 15, 19, 0.95) 100%);
      border-color: var(--line);
    }

    /* ── CALLOUT / FORMULA / PROMO / VIDEO ── */
    .callout-box {
      background: linear-gradient(180deg, rgba(217, 184, 119, 0.055) 0%, rgba(11, 11, 14, 0.6) 100%);
      border: 1px solid var(--accent-amber-border);
      border-left: 2px solid var(--accent-amber);
      border-radius: 0.9rem;
      padding: 1rem 1.15rem;
    }
    .callout-content {
      color: #e9e2d2;
      font-weight: 500;
    }
    .callout-content strong {
      color: #ffffff;
    }
    .formula-box {
      background: var(--grad-panel);
      border: 1px solid var(--line);
      border-radius: 0.9rem;
    }
    .formula-title {
      color: var(--silver-dim);
    }
    .formula-code {
      background: rgba(5, 5, 6, 0.65);
      border-color: var(--line-soft);
      color: var(--off-white);
    }
    .promo-checker-box {
      background: var(--grad-panel);
      border: 1px solid var(--line);
      border-radius: 1rem;
      box-shadow: 0 14px 34px -28px rgba(0, 0, 0, 0.95);
    }
    .promo-link-btn {
      background: rgba(255, 255, 255, 0.04);
      border-color: var(--line-strong);
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset;
    }
    .promo-link-btn:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(208, 211, 217, 0.35);
    }
    .video-wrapper {
      border-color: var(--line-strong);
      background: #000000;
      box-shadow:
        0 20px 50px -30px rgba(0, 0, 0, 0.95),
        0 0 0 1px rgba(255, 255, 255, 0.03) inset;
    }

    /* ── MOBILE / TABLET CHIPS ── */
    .mobile-category-bar {
      background: rgba(9, 9, 12, 0.96);
      border-color: var(--line-soft);
      border-radius: 0.9rem;
      box-shadow: 0 12px 30px -22px rgba(0, 0, 0, 0.95);
    }
    .mobile-cat-pill {
      background: rgba(255, 255, 255, 0.03);
      border-color: var(--line-soft);
      color: var(--ash);
    }
    .mobile-cat-pill:hover {
      color: #ffffff;
      border-color: var(--line-strong);
    }
    .mobile-cat-pill.active {
      background: var(--grad-silver);
      border-color: rgba(255, 255, 255, 0.55);
      color: var(--void);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.7) inset,
        0 6px 18px -10px rgba(208, 211, 217, 0.45);
    }

    /* ── COPYABLE ID CHIP ── */
    .doc-id {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.05rem 0.4rem;
      margin: 0 0.05rem;
      border-radius: 0.35rem;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.04);
      color: var(--silver-accent);
      font-family: var(--font-mono);
      font-size: 0.86em;
      font-weight: 600;
      cursor: pointer;
      vertical-align: baseline;
      transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    }
    .doc-id:hover {
      color: #ffffff;
      border-color: var(--line-strong);
      background: rgba(255, 255, 255, 0.08);
    }
    .doc-id svg {
      opacity: 0.6;
      flex-shrink: 0;
    }

    /* ── FOOTER ── */
    .site-footer {
      background: linear-gradient(180deg, rgba(5, 5, 6, 0) 0%, rgba(0, 0, 0, 0.35) 100%);
      border-top: 1px solid var(--line-soft);
    }
    .site-footer p:first-child {
      font-family: var(--font-display);
      letter-spacing: -0.01em;
    }
    .footer-link {
      color: var(--ash);
    }
    .footer-link:hover {
      color: #ffffff;
    }

    /* ── TOAST / BACK TO TOP ── */
    .toast {
      background: linear-gradient(180deg, rgba(18, 18, 23, 0.98) 0%, rgba(9, 9, 12, 0.98) 100%);
      border-color: var(--line-strong);
      box-shadow: var(--shadow-deep), 0 0 0 1px rgba(255, 255, 255, 0.03) inset;
    }
    .back-to-top {
      background: linear-gradient(180deg, rgba(33, 33, 40, 0.94) 0%, rgba(15, 15, 19, 0.94) 100%);
      border-color: var(--line-strong);
      color: var(--silver-accent);
    }
    .back-to-top:hover {
      color: #ffffff;
      border-color: rgba(208, 211, 217, 0.4);
      box-shadow: 0 10px 30px -12px rgba(208, 211, 217, 0.35);
    }

    /* ── COMMAND PALETTE ── */
    body.cmdk-open {
      overflow: hidden;
    }
    .cmdk {
      position: fixed;
      inset: 0;
      z-index: 120;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: min(13vh, 7rem) 1rem 2rem;
    }
    .cmdk[hidden] {
      display: none;
    }
    .cmdk__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(3, 3, 5, 0.72);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }
    .cmdk__panel {
      position: relative;
      display: flex;
      flex-direction: column;
      width: min(620px, 100%);
      max-height: min(70vh, 560px);
      overflow: hidden;
      border-radius: 1rem;
      border: 1px solid transparent;
      background:
        linear-gradient(180deg, rgba(18, 18, 23, 0.99) 0%, rgba(9, 9, 12, 0.99) 100%) padding-box,
        linear-gradient(140deg, rgba(255, 255, 255, 0.24) 0%, rgba(208, 211, 217, 0.08) 46%, rgba(255, 255, 255, 0.18) 100%) border-box;
      box-shadow: var(--shadow-deep), 0 0 70px -34px rgba(208, 211, 217, 0.38);
      animation: cmdkIn 0.22s var(--ease-out-quint);
    }
    @keyframes cmdkIn {
      from { opacity: 0; transform: translateY(-8px) scale(0.985); }
      to { opacity: 1; transform: none; }
    }
    .cmdk__search {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.9rem 1rem;
      border-bottom: 1px solid var(--line-soft);
      color: var(--silver-dim);
    }
    .cmdk__search input {
      flex: 1;
      min-width: 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: #ffffff;
      font-family: inherit;
      font-size: 0.95rem;
    }
    .cmdk__search input::placeholder {
      color: var(--silver-deep);
    }
    .cmdk__list {
      list-style: none;
      margin: 0;
      padding: 0.4rem;
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .cmdk__group {
      padding: 0.55rem 0.75rem 0.3rem;
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--silver-deep);
    }
    .cmdk__item {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.6rem 0.7rem;
      border-radius: 0.6rem;
      color: var(--text-2);
      font-size: 0.875rem;
      cursor: pointer;
    }
    .cmdk__item:hover,
    .cmdk__item[aria-selected="true"] {
      background: rgba(255, 255, 255, 0.06);
      color: #ffffff;
    }
    .cmdk__num {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      color: var(--silver-deep);
      min-width: 1.4rem;
    }
    .cmdk__tab {
      margin-left: auto;
      padding: 0.1rem 0.45rem;
      border: 1px solid var(--line-soft);
      border-radius: 9999px;
      font-size: 0.625rem;
      color: var(--silver-deep);
      white-space: nowrap;
    }
    .cmdk__empty {
      padding: 1.2rem 0.8rem;
      text-align: center;
      font-size: 0.85rem;
      color: var(--ash);
    }
    .cmdk__hint {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 1rem;
      padding: 0.55rem 1rem;
      border-top: 1px solid var(--line-soft);
      font-size: 0.6875rem;
      color: var(--silver-deep);
    }
    .cmdk__hint kbd {
      padding: 0.05rem 0.3rem;
      border: 1px solid var(--line);
      border-radius: 4px;
      background: rgba(0, 0, 0, 0.35);
      font-family: var(--font-mono);
      font-size: 0.625rem;
    }
    .cmdk__close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.9rem;
      height: 1.9rem;
      flex-shrink: 0;
      border: 1px solid var(--line-soft);
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.03);
      color: var(--silver-dim);
      cursor: pointer;
      transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }
    .cmdk__close:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.07);
      border-color: var(--line-strong);
    }

    /* ── SCROLL REVEAL (JS progressive enhancement only) ── */
    [data-reveal] {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.5s var(--ease-out-quint), transform 0.5s var(--ease-out-quint);
    }
    [data-reveal].is-in {
      opacity: 1;
      transform: none;
    }

    /* ── RESPONSIVE REFINEMENTS ── */
    @media (max-width: 1024px) {
      .doc-title {
        font-size: clamp(1.9rem, 5.6vw, 2.6rem);
      }
      .doc-hero::before {
        left: -0.5rem;
      }
      .mobile-category-bar {
        border-radius: 0.9rem;
      }
    }

    @media (max-width: 640px) {
      .brand-mark {
        width: 2.1rem;
        height: 2.1rem;
      }
      .brand-name {
        font-size: 0.95rem;
      }
      .doc-title {
        font-size: clamp(1.75rem, 8.6vw, 2.25rem);
      }
      .doc-lead {
        font-size: 0.9rem;
        line-height: 1.65;
      }
      .doc-kicker {
        font-size: 0.5625rem;
        letter-spacing: 0.2em;
        margin-bottom: 0.75rem;
      }
      .doc-actions {
        width: 100%;
        gap: 0.5rem;
      }
      .doc-actions .pade-btn {
        flex: 1 1 calc(50% - 0.25rem);
      }
      .doc-actions .pade-btn-primary {
        flex-basis: 100%;
      }
      .doc-meta {
        font-size: 0.7rem;
        margin-bottom: 1.25rem;
      }
      .rule-card {
        padding: 1rem;
        border-radius: 0.85rem;
      }
      .rule-card-title {
        font-size: 0.9rem;
      }
      .mobile-cat-pill {
        color: var(--ash);
      }
    }

    @media (max-width: 480px) {
      .brand-sub {
        display: none;
      }
      .icon-btn {
        width: 2.2rem;
        height: 2.2rem;
        min-width: 2.2rem;
        padding: 0;
      }
      .icon-btn kbd {
        display: none;
      }
      .header-actions {
        gap: 0.4rem;
      }
      .doc-actions .pade-btn {
        font-size: 0.78rem;
        padding: 0.5rem 0.8rem;
      }
      .cmdk {
        padding: 4.5rem 0.6rem 1rem;
      }
      .cmdk__panel {
        max-height: calc(100dvh - 6rem);
      }
    }

    @media (hover: none), (pointer: coarse) {
      .rule-card:hover {
        transform: none;
      }
    }

    /* ── PRINT: clean paper version of the docs ── */
    @media print {
      .top-header,
      .sidebar,
      .sidebar-progress,
      .mobile-category-bar,
      .back-to-top,
      .toast,
      .cmdk,
      .reading-progress,
      .ambient-mesh,
      .site-footer,
      .doc-actions,
      .section-anchor-btn,
      .skip-link {
        display: none !important;
      }
      body {
        background: #ffffff !important;
        color: #111111 !important;
      }
      .layout-wrapper {
        display: block;
        max-width: none;
        padding: 0;
      }
      .main-content {
        max-width: none;
      }
      .tab-panel-view {
        display: none !important;
      }
      .tab-panel-view.active {
        display: block !important;
      }
      .doc-title {
        background: none;
        color: #111111;
        -webkit-text-fill-color: #111111;
      }
      .doc-lead,
      .doc-meta,
      .section-title,
      .rule-card-title,
      .rules-list-item,
      .callout-content {
        color: #111111 !important;
      }
      .rules-list-item strong {
        color: #000000 !important;
      }
      .rule-card,
      .callout-box,
      .promo-checker-box,
      .formula-box {
        background: #ffffff !important;
        border: 1px solid #cccccc !important;
        box-shadow: none !important;
        break-inside: avoid;
      }
      /* Code + pills would otherwise send a solid ink block to the printer. */
      .formula-code,
      .number-badge,
      .icon-badge,
      .doc-id {
        background: #ffffff !important;
        border: 1px solid #cccccc !important;
        color: #111111 !important;
        box-shadow: none !important;
      }
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
      }
      .section-divider {
        background: #dddddd !important;
        opacity: 1;
      }
      a {
        color: #111111 !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      .cmdk__panel {
        animation: none;
      }
    }

    /* ══════════════════════════════════════════════════════════════════
       PADE · DOCS EXTRAS
       Theme switch, command palette commands, progress ring, section
       focus flash, sidebar read times and the shortcut sheet.
       ══════════════════════════════════════════════════════════════════ */

    /* ── THEME TOGGLE ── */
    .theme-toggle .icon-moon {
      display: none;
    }
    html[data-theme="light"] .theme-toggle .icon-sun {
      display: none;
    }
    html[data-theme="light"] .theme-toggle .icon-moon {
      display: block;
    }

    /* ── SIDEBAR READ-TIME BADGE ── */
    .nav-time {
      margin-left: auto;
      padding-left: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      font-weight: 500;
      color: var(--silver-deep);
      opacity: 0.85;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .sidebar-nav-link.active .nav-time {
      color: var(--off-white);
      opacity: 0.92;
    }

    /* ── BACK-TO-TOP PROGRESS RING ── */
    .back-to-top {
      overflow: visible;
    }
    .back-to-top__ring {
      position: absolute;
      inset: -5px;
      width: calc(100% + 10px);
      height: calc(100% + 10px);
      transform: rotate(-90deg);
      pointer-events: none;
    }
    .back-to-top__track,
    .back-to-top__meter {
      fill: none;
      stroke-width: 2;
    }
    .back-to-top__track {
      stroke: var(--line-strong);
    }
    .back-to-top__meter {
      stroke: var(--silver-accent);
      stroke-linecap: round;
      stroke-dasharray: 119.4;
      stroke-dashoffset: 119.4;
      transition: stroke-dashoffset 0.15s linear;
    }

    /* ── SECTION FOCUS FLASH (after jumping from the palette / sidebar) ── */
    @keyframes padeSectionFlash {
      0%   { box-shadow: 0 0 0 0 rgba(208, 211, 217, 0); }
      18%  { box-shadow: 0 0 0 3px var(--glow-mid); }
      100% { box-shadow: 0 0 0 0 rgba(208, 211, 217, 0); }
    }
    .tos-section.is-flashing {
      border-radius: 1rem;
      animation: padeSectionFlash 1.6s var(--ease-out-quint) 1;
    }

    /* ── COMMAND PALETTE: COMMAND ROWS ── */
    .cmdk__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 1.4rem;
      color: var(--silver-deep);
    }
    .cmdk__item:hover .cmdk__icon,
    .cmdk__item[aria-selected="true"] .cmdk__icon {
      color: var(--silver-accent);
    }
    .cmdk__key {
      margin-left: auto;
      padding: 0.1rem 0.45rem;
      border: 1px solid var(--line);
      border-radius: 0.35rem;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      color: var(--silver-deep);
      white-space: nowrap;
    }

    /* ── SHORTCUT SHEET ── */
    @keyframes padeSheetIn {
      from { opacity: 0; transform: translateY(10px) scale(0.985); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .kbd-sheet {
      position: fixed;
      inset: 0;
      z-index: 160;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
    }
    .kbd-sheet[hidden] {
      display: none;
    }
    .kbd-sheet__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(3, 3, 5, 0.72);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .kbd-sheet__panel {
      position: relative;
      width: min(27rem, 100%);
      padding: 1.1rem 1.2rem 1.2rem;
      border: 1px solid var(--line-soft);
      border-radius: 1rem;
      background: var(--grad-panel);
      box-shadow: var(--shadow-deep);
      animation: padeSheetIn 0.24s var(--ease-out-quint) both;
    }
    .kbd-sheet__title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.9rem;
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--white);
    }
    .kbd-sheet__list {
      display: grid;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .kbd-sheet__list li {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      font-size: 0.8125rem;
      color: var(--text-2);
    }
    .kbd-sheet__keys {
      display: inline-flex;
      gap: 0.25rem;
    }
    .kbd-sheet__keys kbd {
      min-width: 1.5rem;
      padding: 0.1rem 0.4rem;
      border: 1px solid var(--line);
      border-radius: 0.35rem;
      background: rgba(255, 255, 255, 0.04);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      text-align: center;
      color: var(--silver-accent);
    }

    @media (prefers-reduced-motion: reduce) {
      .kbd-sheet__panel,
      .tos-section.is-flashing {
        animation: none !important;
      }
      .back-to-top__meter {
        transition: none !important;
      }
    }

    @media (max-width: 640px) {
      .theme-toggle {
        display: none;
      }
      .kbd-sheet__panel {
        padding: 1rem 0.95rem 1.05rem;
      }
    }

    /* ══════════════════════════════════════════════════════════════════
       LIGHT THEME — "SILVER PAPER"
       Same monochrome brand (void / graphite / silver), inverted.
       Every rule below is scoped to html[data-theme="light"], so the
       verified dark design is untouched.
       ══════════════════════════════════════════════════════════════════ */
    html[data-theme="light"] {
