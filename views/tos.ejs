  <script>
    // ── SHARED ELEMENTS ──
    const rootEl = document.documentElement;
    const headerEl = document.querySelector('.top-header');
    const navWrapper = document.getElementById('navTabsWrapper');
    const navSlider = document.getElementById('navPillSlider');
    const tabLinks = document.querySelectorAll('.nav-tab-link');
    const tabPanels = document.querySelectorAll('.tab-panel-view');
    const sidebarPanels = document.querySelectorAll('.sidebar-panel-view');
    const backToTopBtn = document.getElementById('backToTop');
    const backToTopMeter = document.getElementById('backToTopMeter');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Keep the sticky offsets in sync with the real rendered header / chips bar.
    function syncStickyMetrics() {
      if (headerEl) {
        rootEl.style.setProperty('--header-h', `${Math.round(headerEl.getBoundingClientRect().height)}px`);
      }
      const activeBar = document.querySelector('.tab-panel-view.active .mobile-category-bar');
      const barVisible = activeBar && window.getComputedStyle(activeBar).display !== 'none';
      rootEl.style.setProperty('--chips-h', barVisible ? `${Math.round(activeBar.getBoundingClientRect().height)}px` : '0px');
    }

    function stickyOffset() {
      const headerH = headerEl ? headerEl.getBoundingClientRect().height : 0;
      const activeBar = document.querySelector('.tab-panel-view.active .mobile-category-bar');
      const barVisible = activeBar && window.getComputedStyle(activeBar).display !== 'none';
      const barH = barVisible ? activeBar.getBoundingClientRect().height : 0;
      return headerH + barH + 12;
    }

    function scrollToSection(hash, behavior) {
      if (!hash || hash.charAt(0) !== '#') return false;
      let targetEl = null;
      try {
        targetEl = document.querySelector(hash);
      } catch (err) {
        targetEl = null;
      }
      if (!targetEl) return false;
      const top = targetEl.getBoundingClientRect().top + window.pageYOffset - stickyOffset();
      window.scrollTo({ top: Math.max(0, top), behavior: behavior || 'smooth' });
      flashSection(targetEl);
      return true;
    }

    // Ring the section the reader just jumped to, so a deep link or a
    // palette jump is instantly obvious.
    let flashTimer = null;
    function flashSection(el) {
      if (!el || !el.classList || !el.classList.contains('tos-section') || reduceMotion.matches) return;
      el.classList.remove('is-flashing');
      void el.offsetWidth; // restart the animation
      el.classList.add('is-flashing');
      window.clearTimeout(flashTimer);
      flashTimer = window.setTimeout(() => el.classList.remove('is-flashing'), 1800);
    }

    function positionSlider(el) {
      if (!navWrapper || !navSlider || !el) return;
      const wrapRect = navWrapper.getBoundingClientRect();
      const elRect = el.getBoundingClientRect();
      if (!elRect.width) return;
      navSlider.style.left = `${elRect.left - wrapRect.left}px`;
      navSlider.style.width = `${elRect.width}px`;
      // Only paint the silver slider once it is actually measured, so a
      // no-JS / pre-measure render never hides the active tab label.
      navWrapper.classList.add('has-slider');
    }

    function switchTab(tabName, updateHistory, options) {
      if (!tabName) return;
      const opts = options || {};
      const targetBtn = document.querySelector(`.nav-tab-link[data-tab="${tabName}"]`);
      if (!targetBtn) return;

      tabLinks.forEach(link => {
        link.classList.remove('active');
        link.removeAttribute('aria-current');
      });
      targetBtn.classList.add('active');
      targetBtn.setAttribute('aria-current', 'page');
      positionSlider(targetBtn);

      tabPanels.forEach(panel => {
        const isMatch = panel.getAttribute('data-tab-content') === tabName;
        panel.classList.toggle('active', isMatch);
      });

      sidebarPanels.forEach(sb => {
        const isMatch = sb.getAttribute('data-tab-sidebar') === tabName;
        sb.classList.toggle('active', isMatch);
      });

      revealInViewNow(document.querySelector('.tab-panel-view.active'));

      const targetPath = targetBtn.getAttribute('data-path') || `/${tabName}`;
      if (updateHistory) {
        if (window.location.pathname !== targetPath) {
          window.history.pushState({ tab: tabName }, '', targetPath);
        }
      }

      // Update document title dynamically
      if (tabName === 'rules') {
        document.title = 'Server Rules · Pade Community';
      } else if (tabName === 'tos') {
        document.title = 'Terms of Service · Pade Store';
      } else if (tabName === 'tutorial') {
        document.title = 'Tutorial & Hướng Dẫn · Pade Store';
      }

      syncStickyMetrics();
      updateHeroMeta();
      if (!opts.preserveScroll) {
        window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      }
    }

    // Attach click and hover events to tab buttons
    tabLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const tab = link.getAttribute('data-tab');
        switchTab(tab, true);
      });
      link.addEventListener('mouseenter', () => {
        positionSlider(link);
      });
      link.addEventListener('focus', () => {
        positionSlider(link);
      });
    });

    if (navWrapper) {
      navWrapper.addEventListener('mouseleave', () => {
        const activeLink = document.querySelector('.nav-tab-link.active');
        if (activeLink) positionSlider(activeLink);
      });
    }

    // Footer switcher links
    document.querySelectorAll('.tab-switcher-link').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const tab = link.getAttribute('data-tab');
        switchTab(tab, true);
      });
    });

    // Handle browser back/forward buttons
    window.addEventListener('popstate', () => {
      determineInitialTab(false, true);
    });

    function determineInitialTab(updateHistory, preserveScroll) {
      const path = (window.location.pathname || '').toLowerCase();
      const host = (window.location.hostname || '').toLowerCase();
      let defaultTab = '<%= typeof activeTab !== "undefined" ? activeTab : "rules" %>';

      if (path.includes('tos') || host.startsWith('tos.')) {
        defaultTab = 'tos';
      } else if (path.includes('tutorial') || host.startsWith('tutorial.')) {
        defaultTab = 'tutorial';
      } else if (path.includes('rules') || host.startsWith('rules.')) {
        defaultTab = 'rules';
      }

      switchTab(defaultTab, !!updateHistory, { preserveScroll: !!preserveScroll });
    }

    function initPage() {
      syncStickyMetrics();
      const initialHash = window.location.hash;
      determineInitialTab(false, !!initialHash);
      if (initialHash) {
        // Wait for the target tab to be displayed before measuring it.
        requestAnimationFrame(() => {
          requestAnimationFrame(() => scrollToSection(initialHash, 'auto'));
        });
      }
      updateScrollUi();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage, { once: true });
    } else {
      initPage();
    }

    window.addEventListener('load', () => {
      syncStickyMetrics();
      const activeLink = document.querySelector('.nav-tab-link.active');
      if (activeLink) positionSlider(activeLink);
      updateScrollUi();
    });

    let resizeTimer = null;
    window.addEventListener('resize', () => {
      syncStickyMetrics();
      const activeLink = document.querySelector('.nav-tab-link.active');
      if (activeLink) positionSlider(activeLink);
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(updateScrollUi, 120);
    });

    window.addEventListener('orientationchange', () => {
      window.setTimeout(() => {
        syncStickyMetrics();
        const activeLink = document.querySelector('.nav-tab-link.active');
        if (activeLink) positionSlider(activeLink);
        updateScrollUi();
      }, 180);
    });

    if (window.ResizeObserver && headerEl) {
      new ResizeObserver(syncStickyMetrics).observe(headerEl);
    }

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        syncStickyMetrics();
        const activeLink = document.querySelector('.nav-tab-link.active');
        if (activeLink) positionSlider(activeLink);
      });
    }

    // ── SCROLL UI (reading progress + scrollspy + back-to-top) ──
    function updateScrollUi() {
      // Reading progress
      const progressEl = document.getElementById('readingProgress');
      const scrollTotal = rootEl.scrollHeight - rootEl.clientHeight;
      const progress = scrollTotal > 0 ? Math.min(1, window.scrollY / scrollTotal) : 0;
      if (progressEl) {
        progressEl.style.transform = `scaleX(${progress})`;
      }
      if (backToTopMeter) {
        backToTopMeter.style.strokeDashoffset = String(119.4 * (1 - progress));
      }

      // Back-to-top visibility
      if (backToTopBtn) {
        backToTopBtn.classList.toggle('show', window.scrollY > 640);
      }

      // ScrollSpy for active sidebar nav item & mobile chips
      const activePanel = document.querySelector('.tab-panel-view.active');
      if (!activePanel) return;
      const sections = activePanel.querySelectorAll('.tos-section');
      if (!sections.length) return;
      const activeSidebar = document.querySelector('.sidebar-panel-view.active');
      const navItems = activeSidebar ? activeSidebar.querySelectorAll('.sidebar-nav-link') : [];
      const mobilePills = activePanel.querySelectorAll('.mobile-cat-pill');

      const anchorLine = stickyOffset() + 12;
      let current = '';
      sections.forEach(sec => {
        if (sec.getBoundingClientRect().top <= anchorLine) {
          current = sec.getAttribute('id');
        }
      });
      // At the very bottom of the document, highlight the last section.
      if (window.innerHeight + window.scrollY >= rootEl.scrollHeight - 8) {
        current = sections[sections.length - 1].getAttribute('id');
      }
      if (!current) return;

      navItems.forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${current}`);
      });

      mobilePills.forEach(pill => {
        const match = pill.getAttribute('href') === `#${current}`;
        pill.classList.toggle('active', match);
        if (match && pill.parentElement && window.innerWidth <= 1024) {
          const bar = pill.parentElement;
          if (bar.scrollWidth > bar.clientWidth) {
            const targetLeft = pill.offsetLeft - (bar.clientWidth - pill.offsetWidth) / 2;
            bar.scrollTo({
              left: Math.max(0, targetLeft),
              behavior: reduceMotion.matches ? 'auto' : 'smooth'
            });
          }
        }
      });

      updateSidebarMeter(activePanel);
    }

    let scrollTicking = false;
    window.addEventListener('scroll', () => {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(() => {
        updateScrollUi();
        scrollTicking = false;
      });
    }, { passive: true });

    // Smooth click handler for mobile category pills
    document.querySelectorAll('.mobile-cat-pill').forEach(pill => {
      pill.addEventListener('click', (e) => {
        const targetId = pill.getAttribute('href');
        if (targetId && targetId.startsWith('#')) {
          e.preventDefault();
          if (scrollToSection(targetId, reduceMotion.matches ? 'auto' : 'smooth')) {
            const parent = pill.parentElement;
            if (parent) {
              parent.querySelectorAll('.mobile-cat-pill').forEach(p => p.classList.remove('active'));
              pill.classList.add('active');
            }
          }
        }
      });
    });

    // Back to top
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      });
    }

    // Copy section link (with fallback for older / non-secure contexts)
    let toastTimer = null;
    function showToast(message) {
      const toast = document.getElementById('toastBox');
      if (!toast) return;
      const label = toast.querySelector('span');
      if (label && typeof message === 'string' && message) {
        label.textContent = message;
      }
      toast.classList.add('show');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('show'), 2200);
    }

    function copyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text);
      }
      return new Promise((resolve, reject) => {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.top = '-9999px';
        document.body.appendChild(area);
        area.select();
        try {
          document.execCommand('copy') ? resolve() : reject(new Error('copy failed'));
        } catch (err) {
          reject(err);
        } finally {
          document.body.removeChild(area);
        }
      });
    }

    function copySectionLink(hash, e) {
      if (e) e.preventDefault();
      let base = `${window.location.origin}${window.location.pathname}`;
      const panel = e && e.currentTarget && e.currentTarget.closest ? e.currentTarget.closest('.tab-panel-view') : null;
      const tab = panel ? panel.getAttribute('data-tab-content') : null;
      if (tab) base = `${window.location.origin}/${tab}`;
      const url = `${base}${hash}`;
      copyText(url)
        .then(() => showToast('Đã sao chép liên kết mục!'))
        .catch(() => showToast('Không sao chép được liên kết.'));
    }
    // ══════════════════════════════════════════════════════════════════
    // PREMIUM LAYER — hero stats, doc search palette, micro-interactions
    // ══════════════════════════════════════════════════════════════════

    const TAB_LABELS = { rules: 'Rules', tos: 'ToS', tutorial: 'Tutorial' };

    function activeTabName() {
      const link = document.querySelector('.nav-tab-link.active');
      return link ? link.getAttribute('data-tab') : 'rules';
    }

    // ── Hero meta: reading time + section count, measured per tab ──
    function updateHeroMeta() {
      const panel = document.querySelector('.tab-panel-view.active');
      if (!panel) return;
      const hero = panel.querySelector('.doc-hero');
      if (!hero) return;

      const words = (panel.textContent || '').trim().split(/\s+/).filter(Boolean).length;
      const minutes = Math.max(1, Math.round(words / 210));
      const readingEl = hero.querySelector('[data-reading-time]');
      if (readingEl) readingEl.textContent = `~${minutes} phút đọc`;

      const countEl = hero.querySelector('[data-section-count]');
      if (countEl) {
        const total = panel.querySelectorAll('.tos-section').length;
        countEl.textContent = `${total} mục`;
      }
    }

    // ── Sidebar reading meter ──
    const sidebarFill = document.getElementById('sidebarProgressFill');
    function updateSidebarMeter(panel) {
      if (!sidebarFill || !panel) return;
      const top = panel.getBoundingClientRect().top + window.pageYOffset;
      const height = Math.max(1, panel.offsetHeight);
      const viewed = window.scrollY + window.innerHeight - top;
      const ratio = Math.max(0, Math.min(1, viewed / height));
      sidebarFill.style.width = `${(ratio * 100).toFixed(1)}%`;
    }

    // ── Pointer spotlight on surfaces (fine pointers only) ──
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll('.rule-card').forEach(card => {
        card.addEventListener('pointermove', (event) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
          card.style.setProperty('--my', `${event.clientY - rect.top}px`);
        });
      });
    }

    // ── Scroll reveal (progressive enhancement; JS-off keeps everything visible) ──
    function revealInViewNow(panel) {
      if (!panel) return;
      panel.querySelectorAll('[data-reveal]').forEach(el => {
        if (el.classList.contains('is-in')) return;
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          // Reveal without animating: prevents a fade-in flash on tab switches.
          el.style.transition = 'none';
          el.classList.add('is-in');
          requestAnimationFrame(() => { el.style.transition = ''; });
        }
      });
    }

    if ('IntersectionObserver' in window && !reduceMotion.matches) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          revealObserver.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.04 });

      document.querySelectorAll('.tab-panel-view .rule-card, .tab-panel-view .callout-box, .tab-panel-view .promo-checker-box, .tab-panel-view .video-wrapper').forEach(el => {
        const rect = el.getBoundingClientRect();
        // Anything already on screen at boot stays visible — we only animate
        // surfaces the reader scrolls down to, which avoids any first-paint flash.
        if (rect.top < window.innerHeight && rect.bottom > 0) return;
        el.setAttribute('data-reveal', '');
        revealObserver.observe(el);
      });
    }

    // ── Copyable Discord snowflake IDs (17–20 digits) ──
    function enhanceCopyableIds() {
      const scope = document.getElementById('docMain');
      if (!scope || !window.NodeFilter) return;
      const walker = document.createTreeWalker(scope, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          if (!node.nodeValue || !/\b\d{17,20}\b/.test(node.nodeValue)) return NodeFilter.FILTER_REJECT;
          const parent = node.parentElement;
          if (!parent || parent.closest('script, style, a, button')) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        }
      });

      const targets = [];
      while (walker.nextNode()) targets.push(walker.currentNode);

      targets.forEach(node => {
        const parts = node.nodeValue.split(/(\b\d{17,20}\b)/);
        if (parts.length < 3) return;
        const frag = document.createDocumentFragment();
        parts.forEach(part => {
          if (/^\d{17,20}$/.test(part)) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'doc-id';
            btn.dataset.copy = part;
            btn.title = 'Sao chép ID';
            btn.setAttribute('aria-label', `Sao chép ID ${part}`);
            const label = document.createElement('span');
            label.textContent = part;
            btn.appendChild(label);
            btn.insertAdjacentHTML('beforeend', '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>');
            frag.appendChild(btn);
          } else if (part) {
            frag.appendChild(document.createTextNode(part));
          }
        });
        node.parentNode.replaceChild(frag, node);
      });
    }

    // ── Copy affordances: section IDs and page links ──
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const copyTarget = event.target.closest('[data-copy]');
      if (!copyTarget) return;
      event.preventDefault();
      copyText(copyTarget.dataset.copy)
        .then(() => showToast('Đã sao chép ID!'))
        .catch(() => showToast('Không sao chép được.'));
    });

    function copyPageLink() {
      return copyText(window.location.href)
        .then(() => showToast('Đã sao chép liên kết trang!'))
        .catch(() => showToast('Không sao chép được liên kết.'));
    }

    document.querySelectorAll('[data-copy-page]').forEach(btn => {
      btn.addEventListener('click', () => { copyPageLink(); });
    });

    document.querySelectorAll('.sidebar-nav-link').forEach(link => {
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href');
        if (!href || href.charAt(0) !== '#') return;
        event.preventDefault();
        scrollToSection(href, reduceMotion.matches ? 'auto' : 'smooth');
        try {
          window.history.replaceState({ tab: activeTabName() }, '', href);
        } catch (err) { /* ignore history limits */ }
      });
    });

    // Arrow-key navigation across the top document tabs.
    if (navWrapper) {
      navWrapper.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        const links = Array.from(tabLinks);
        const index = links.indexOf(document.activeElement);
        if (index === -1) return;
        event.preventDefault();
        const step = event.key === 'ArrowRight' ? 1 : -1;
        links[(index + step + links.length) % links.length].focus();
      });
    }

    // ── Command palette: search every section of all three documents ──
    const cmdk = document.getElementById('cmdk');
    const cmdkInput = document.getElementById('cmdkInput');
    const cmdkList = document.getElementById('cmdkList');
    let paletteIndex = [];
    let paletteResults = [];
    let paletteActive = -1;
    let paletteReturnFocus = null;

    // Palette commands — the palette doubles as a command bar.
    const PALETTE_ICONS = {
      theme: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"></path></svg>',
      print: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6"></path><path d="M6 18H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8" rx="1"></rect></svg>',
      link: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>',
      keys: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"></rect><path d="M7 10h.01"></path><path d="M11 10h.01"></path><path d="M15 10h.01"></path><path d="M7 14h10"></path></svg>',
      discord: '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028z"/></svg>',
      up: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path></svg>'
    };

    const PALETTE_COMMANDS = [
      { id: 'cmd-theme', title: 'Đổi giao diện sáng / tối', key: 'Shift D', icon: 'theme', run: () => toggleTheme() },
      { id: 'cmd-print', title: 'In trang này', key: '⌘P', icon: 'print', run: () => window.print() },
      { id: 'cmd-copy', title: 'Sao chép liên kết trang', key: '', icon: 'link', run: () => { copyPageLink(); } },
      { id: 'cmd-shortcuts', title: 'Xem bảng phím tắt', key: '?', icon: 'keys', run: () => openShortcuts() },
      { id: 'cmd-discord', title: 'Tham gia Discord Pade', key: '', icon: 'discord', run: () => window.open('https://discord.gg/pade', '_blank', 'noopener') },
      { id: 'cmd-top', title: 'Về đầu trang', key: 'g g', icon: 'up', run: () => window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' }) }
    ];

    function normalizeSearch(value) {
      return (value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/Đ/g, 'D')
        .toLowerCase();
    }

    function buildPaletteIndex() {
      paletteIndex = [];
      document.querySelectorAll('.tab-panel-view').forEach(panel => {
        const tab = panel.getAttribute('data-tab-content');
        panel.querySelectorAll('.tos-section').forEach(section => {
          const titleEl = section.querySelector('.section-title');
          const numEl = section.querySelector('.number-badge');
          paletteIndex.push({
            id: section.id,
            tab: tab,
            num: numEl ? numEl.textContent.trim() : '',
            title: (titleEl ? titleEl.textContent : section.id).replace(/\s+/g, ' ').trim()
          });
        });
      });
    }

    function setPaletteActive(index) {
      paletteActive = index;
      cmdkList.querySelectorAll('.cmdk__item').forEach(el => {
        const isActive = Number(el.dataset.index) === index;
        el.setAttribute('aria-selected', isActive ? 'true' : 'false');
        if (!isActive) return;
        const listRect = cmdkList.getBoundingClientRect();
        const itemRect = el.getBoundingClientRect();
        if (itemRect.top < listRect.top) cmdkList.scrollTop -= (listRect.top - itemRect.top);
        else if (itemRect.bottom > listRect.bottom) cmdkList.scrollTop += (itemRect.bottom - listRect.bottom);
      });
    }

    function movePalette(delta) {
      if (!paletteResults.length) return;
      setPaletteActive((paletteActive + delta + paletteResults.length) % paletteResults.length);
    }

    function choosePaletteResult(index) {
      const item = paletteResults[index];
      if (!item) return;
      closePalette();
      if (item.kind === 'command') {
        requestAnimationFrame(() => {
          if (typeof item.run === 'function') item.run();
        });
        return;
      }
      requestAnimationFrame(() => {
        switchTab(item.tab, true, { preserveScroll: true });
        requestAnimationFrame(() => {
          scrollToSection(`#${item.id}`, reduceMotion.matches ? 'auto' : 'smooth');
          try {
            window.history.replaceState({ tab: item.tab }, '', `#${item.id}`);
          } catch (err) { /* ignore history limits */ }
        });
      });
    }

    function renderPalette(query) {
      if (!cmdkList) return;
      const q = normalizeSearch(query.trim());
      const matches = (item, label) => !q
        || normalizeSearch(item.title).includes(q)
        || normalizeSearch(label).includes(q)
        || (item.num || '').toLowerCase().includes(q);

      const sectionResults = paletteIndex
        .map(item => ({ ...item, kind: 'section' }))
        .filter(item => matches(item, TAB_LABELS[item.tab] || item.tab));
      const commandResults = PALETTE_COMMANDS
        .map(item => ({ ...item, kind: 'command' }))
        .filter(item => matches(item, 'Lệnh'));

      paletteResults = sectionResults.concat(commandResults);

      cmdkList.innerHTML = '';
      if (!paletteResults.length) {
        const empty = document.createElement('li');
        empty.className = 'cmdk__empty';
        empty.textContent = 'Không tìm thấy mục phù hợp.';
        cmdkList.appendChild(empty);
        paletteActive = -1;
        return;
      }

      let lastGroup = null;
      paletteResults.forEach((item, index) => {
        const groupName = item.kind === 'command' ? 'Lệnh' : (TAB_LABELS[item.tab] || item.tab);
        if (groupName !== lastGroup) {
          const group = document.createElement('li');
          group.className = 'cmdk__group';
          group.textContent = groupName;
          cmdkList.appendChild(group);
          lastGroup = groupName;
        }
        const row = document.createElement('li');
        row.className = 'cmdk__item';
        row.setAttribute('role', 'option');
        row.dataset.index = String(index);

        if (item.kind === 'command') {
          const icon = document.createElement('span');
          icon.className = 'cmdk__icon';
          icon.innerHTML = PALETTE_ICONS[item.icon] || '';
          const label = document.createElement('span');
          label.textContent = item.title;
          row.append(icon, label);
          if (item.key) {
            const key = document.createElement('span');
            key.className = 'cmdk__key';
            key.textContent = item.key;
            row.appendChild(key);
          }
        } else {
          const num = document.createElement('span');
          num.className = 'cmdk__num';
          num.textContent = item.num;
          const label = document.createElement('span');
          label.textContent = item.title;
          const tag = document.createElement('span');
          tag.className = 'cmdk__tab';
          tag.textContent = TAB_LABELS[item.tab] || item.tab;
          row.append(num, label, tag);
        }

        row.addEventListener('click', () => choosePaletteResult(index));
        row.addEventListener('mousemove', () => setPaletteActive(index));
        cmdkList.appendChild(row);
      });

      setPaletteActive(0);
    }

    function openPalette() {
      if (!cmdk || !cmdkInput) return;
      paletteReturnFocus = document.activeElement;
      buildPaletteIndex();
      cmdk.hidden = false;
      document.body.classList.add('cmdk-open');
      // Compensate for the disappearing scrollbar so the page never shifts.
      const scrollbarGap = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.paddingRight = scrollbarGap > 0 ? `${scrollbarGap}px` : '';
      cmdkInput.value = '';
      renderPalette('');
      requestAnimationFrame(() => cmdkInput.focus());
    }

    function closePalette() {
      if (!cmdk) return;
      cmdk.hidden = true;
      document.body.classList.remove('cmdk-open');
      document.body.style.paddingRight = '';
      if (paletteReturnFocus && typeof paletteReturnFocus.focus === 'function') {
        paletteReturnFocus.focus({ preventScroll: true });
      }
      paletteReturnFocus = null;
    }

    document.querySelectorAll('[data-open-palette]').forEach(btn => {
      btn.addEventListener('click', openPalette);
    });

    if (cmdk) {
      cmdk.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('[data-cmdk-close]')) closePalette();
      });
    }

    if (cmdkInput) {
      cmdkInput.addEventListener('input', () => renderPalette(cmdkInput.value));
      cmdkInput.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          movePalette(1);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          movePalette(-1);
        } else if (event.key === 'Enter') {
          event.preventDefault();
          if (paletteActive >= 0) choosePaletteResult(paletteActive);
        } else if (event.key === 'Escape') {
          event.preventDefault();
          closePalette();
        }
      });
    }

    function isTypingTarget(el) {
      if (!el) return false;
      const tag = el.tagName;
      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || el.isContentEditable;
    }

    document.addEventListener('keydown', (event) => {
      const key = (event.key || '').toLowerCase();
      if ((event.metaKey || event.ctrlKey) && key === 'k') {
        event.preventDefault();
        if (cmdk && !cmdk.hidden) closePalette();
        else openPalette();
        return;
      }
      if (key === 'escape' && cmdk && !cmdk.hidden) {
        closePalette();
        return;
      }
      if (key === '/' && (!cmdk || cmdk.hidden) && !isTypingTarget(event.target)) {
        event.preventDefault();
        openPalette();
        return;
      }
      if (key === '?' && (!cmdk || cmdk.hidden) && !isTypingTarget(event.target)) {
        event.preventDefault();
        openShortcuts();
        return;
      }
      if (event.shiftKey && !event.metaKey && !event.ctrlKey && event.code === 'KeyD' && !isTypingTarget(event.target)) {
        event.preventDefault();
        toggleTheme();
        return;
      }
      if (key === 'g' && (!cmdk || cmdk.hidden) && !isTypingTarget(event.target)) {
        const now = Date.now();
        if (now - lastGPress < 900) {
          lastGPress = 0;
          window.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
          return;
        }
        lastGPress = now;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && kbdSheet && !kbdSheet.hidden) closeShortcuts();
    });

    // ══════════════════════════════════════════════════════════════════
    // THEME, SHORTCUTS, PRINT & READING EXTRAS
    // ══════════════════════════════════════════════════════════════════
    const themeColorMeta = document.querySelector('meta[name="theme-color"]');
    let lastGPress = 0;

    function currentTheme() {
      return rootEl.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    }

    function syncThemeChrome() {
      const isLight = currentTheme() === 'light';
      document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
        btn.setAttribute('aria-pressed', isLight ? 'true' : 'false');
        const label = isLight ? 'Chuyển sang giao diện tối' : 'Chuyển sang giao diện sáng';
        btn.setAttribute('aria-label', label);
        btn.setAttribute('title', label);
      });
      if (themeColorMeta) {
        themeColorMeta.setAttribute('content', isLight ? '#f1f2f4' : '#0c0d12');
      }
    }

    function setTheme(theme, persist) {
      rootEl.setAttribute('data-theme', theme === 'light' ? 'light' : 'dark');
      if (persist) {
        try { window.localStorage.setItem('pade-docs-theme', theme); } catch (err) { /* ignore */ }
      }
      syncThemeChrome();
    }

    function toggleTheme() {
      const next = currentTheme() === 'light' ? 'dark' : 'light';
      setTheme(next, true);
      showToast(next === 'light' ? 'Đã bật giao diện sáng' : 'Đã bật giao diện tối');
    }

    document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
      btn.addEventListener('click', toggleTheme);
    });
    syncThemeChrome();

    // ── Shortcut sheet ──
    const kbdSheet = document.getElementById('kbdSheet');
    let kbdReturnFocus = null;

    function openShortcuts() {
      if (!kbdSheet || !kbdSheet.hidden) return;
      kbdReturnFocus = document.activeElement;
      kbdSheet.hidden = false;
      const closeBtn = kbdSheet.querySelector('.cmdk__close');
      requestAnimationFrame(() => { if (closeBtn) closeBtn.focus(); });
    }

    function closeShortcuts() {
      if (!kbdSheet || kbdSheet.hidden) return;
      kbdSheet.hidden = true;
      if (kbdReturnFocus && typeof kbdReturnFocus.focus === 'function') {
        kbdReturnFocus.focus({ preventScroll: true });
      }
      kbdReturnFocus = null;
    }

    if (kbdSheet) {
      kbdSheet.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('[data-kbd-close]')) closeShortcuts();
      });
    }

    // ── Print ──
    document.querySelectorAll('[data-print-page]').forEach(btn => {
      btn.addEventListener('click', () => window.print());
    });

    // ── Sidebar read-time badges (measured, so they stay true) ──
    function enhanceSidebarReadTimes() {
      document.querySelectorAll('.sidebar-panel-view').forEach(sidebar => {
        const tab = sidebar.getAttribute('data-tab-sidebar');
        let panel = null;
        try { panel = document.querySelector(`.tab-panel-view[data-tab-content="${tab}"]`); } catch (err) { panel = null; }
        if (!panel) return;
        sidebar.querySelectorAll('.sidebar-nav-link').forEach(link => {
          if (link.querySelector('.nav-time')) return;
          const href = link.getAttribute('href');
          if (!href || href.charAt(0) !== '#') return;
          let section = null;
          try { section = panel.querySelector(href); } catch (err) { section = null; }
          if (!section) return;
          const words = (section.textContent || '').trim().split(/\s+/).filter(Boolean).length;
          const seconds = Math.max(10, Math.round((words / 210) * 60));
          const badge = document.createElement('span');
          badge.className = 'nav-time';
          badge.textContent = seconds < 60 ? `${seconds}s` : `${Math.round(seconds / 60)}p`;
          badge.setAttribute('aria-hidden', 'true');
          link.appendChild(badge);
        });
      });
    }

    // ── Boot the premium layer ──
    updateHeroMeta();
    enhanceCopyableIds();
    enhanceSidebarReadTimes();
    window.addEventListener('load', () => {
      updateHeroMeta();
      const activePanel = document.querySelector('.tab-panel-view.active');
      if (activePanel) updateSidebarMeter(activePanel);
    });
  </script>
</body>
</html>
