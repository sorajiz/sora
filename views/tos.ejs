      --text-2: #45474f;
      --ash: #5f626b;
      --silver-accent: #3f424a;
      --silver-dim: #4f525a;
      --silver-deep: #83868f;
      --glow-soft: rgba(12, 12, 16, 0.06);
      --glow-mid: rgba(12, 12, 16, 0.12);
      --glow-strong: rgba(12, 12, 16, 0.22);
      --shadow-deep: 0 24px 60px -34px rgba(12, 12, 20, 0.32);
      --grad-silver: linear-gradient(180deg, #1c1d22 0%, #3b3d45 46%, #6d707a 100%);
      --grad-panel: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(243, 244, 247, 0.97) 100%);
      --grad-line: linear-gradient(120deg, rgba(12, 12, 16, 0.16) 0%, rgba(12, 12, 16, 0.03) 42%, rgba(12, 12, 16, 0.14) 100%);
      --border-focus: rgba(12, 12, 16, 0.45);
      --accent-amber: #9a7420;
      --accent-amber-bg: rgba(154, 116, 32, 0.08);
      --accent-amber-border: rgba(154, 116, 32, 0.28);
      --accent-red: #a8322c;
      --accent-green: #1f7a44;
      color-scheme: light;
    }

    html[data-theme="light"] ::selection {
      background: rgba(12, 12, 16, 0.16);
      color: #0b0b0e;
    }

    /* Ambient wash — warm paper light instead of the void. */
    html[data-theme="light"] .ambient-mesh {
