<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Terms of Service · Pade Store' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Điều khoản dịch vụ và chính sách mua hàng chính thức tại Pade Store · discord.gg/pade' %>" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#0c0d12" />
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://tos.sorae.tokyo' %>" />

  <!-- OpenGraph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:site_name" content="Pade Store" />
  <meta property="og:title" content="Terms of Service · Pade Store" />
  <meta property="og:description" content="Điều khoản dịch vụ và chính sách mua hàng chính thức tại Pade Store. Cập nhật mới nhất 2026." />
  <meta property="og:url" content="https://tos.sorae.tokyo" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Terms of Service · Pade Store" />
  <meta name="twitter:description" content="Điều khoản dịch vụ và chính sách mua hàng chính thức tại Pade Store." />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="<%= typeof faviconDataUri !== 'undefined' ? faviconDataUri : '/assets/favicon.png' %>" />
  <link rel="shortcut icon" type="image/png" href="/assets/favicon.png" />

  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* ── RESET & DARK GRAY DESIGN SYSTEM (XÁM ĐEN THƯỢNG HẠNG) ── */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --bg-base: #0c0d12;
      --bg-surface: #13141a;
      --bg-surface-elevated: #181922;
      --bg-sidebar-pill: #21232d;
      --bg-badge: #1b1c24;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.16);
      --border-focus: rgba(255, 255, 255, 0.28);
      --text-white: #ffffff;
      --text-main: #f1f2f6;
      --text-sub: #c5c8d4;
      --text-muted: #838896;
      --text-dim: #5c606e;
      --accent-amber: #f59e0b;
      --accent-amber-bg: #1c160c;
      --accent-amber-border: rgba(245, 158, 11, 0.35);
      --accent-blue: #38bdf8;
      --accent-red: #ef4444;
      --color-discord: #5865F2;
      --color-discord-hover: #4752c4;
      --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: "JetBrains Mono", monospace;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
      position: relative;
    }

    /* Subtle ambient dark gradient */
    .ambient-mesh {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle at 15% 15%, rgba(33, 35, 45, 0.4) 0%, transparent 60%),
                  radial-gradient(circle at 85% 85%, rgba(20, 21, 28, 0.6) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    /* Reading Progress Bar */
    .reading-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 100%;
      background: linear-gradient(90deg, #5865f2, #38bdf8, #a855f7);
      transform-origin: 0% 50%;
      transform: scaleX(0);
      z-index: 100;
      transition: transform 0.08s ease-out;
    }

    /* ── HEADER / TOPBAR ── */
    .top-header {
      position: sticky;
      top: 0;
      width: 100%;
      z-index: 50;
      background: rgba(12, 13, 18, 0.82);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-subtle);
      transition: all 0.2s ease;
    }

    .top-header-inner {
      max-width: 1260px;
      margin: 0 auto;
      padding: 0.75rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: inherit;
    }

    .brand-avatar {
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      overflow: hidden;
      border: 1px solid var(--border-strong);
      background: #181920;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .brand-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .brand-name {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text-white);
      letter-spacing: -0.02em;
    }

    .nav-tabs {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      background: rgba(255, 255, 255, 0.03);
      padding: 0.25rem;
      border-radius: 9999px;
      border: 1px solid var(--border-subtle);
    }

    .nav-tab-link {
      padding: 0.35rem 0.85rem;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      border-radius: 9999px;
      transition: all 0.15s ease;
    }

    .nav-tab-link:hover {
      color: var(--text-white);
      background: rgba(255, 255, 255, 0.05);
    }

    .nav-tab-link.active {
      color: var(--text-white);
      background: var(--bg-sidebar-pill);
      border: 1px solid var(--border-subtle);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .btn-discord-join {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-discord);
      color: #fff;
      font-size: 0.8125rem;
      font-weight: 700;
      padding: 0.45rem 0.95rem;
      border-radius: 0.55rem;
      text-decoration: none;
      transition: all 0.15s ease;
      box-shadow: 0 4px 14px rgba(88, 101, 242, 0.25);
    }

    .btn-discord-join:hover {
      background: var(--color-discord-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(88, 101, 242, 0.35);
    }

    /* ── MOBILE NAV TOGGLE ── */
    .mobile-menu-btn {
      display: none;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 0.45rem 0.65rem;
      border-radius: 0.5rem;
      cursor: pointer;
      font-size: 0.8125rem;
      font-weight: 600;
      align-items: center;
      gap: 0.4rem;
    }

    /* ── MAIN CONTENT LAYOUT (2-COLUMN EXACT PARITY TO IMAGE 1) ── */
    .layout-wrapper {
      position: relative;
      z-index: 10;
      max-width: 1260px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 6rem;
      display: flex;
      align-items: flex-start;
      gap: 3.5rem;
    }

    /* ── LEFT SIDEBAR ── */
    .sidebar {
      width: 270px;
      flex-shrink: 0;
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 6.5rem);
      overflow-y: auto;
      padding-right: 0.75rem;
      scrollbar-width: thin;
      scrollbar-color: #2b2e3b transparent;
    }

    .sidebar::-webkit-scrollbar {
      width: 4px;
    }
    .sidebar::-webkit-scrollbar-thumb {
      background: #2b2e3b;
      border-radius: 4px;
    }

    /* Sidebar Quick Search */
    .sidebar-search-box {
      margin-bottom: 1.5rem;
      position: relative;
    }

    .sidebar-search-input {
      width: 100%;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 0.55rem;
      padding: 0.5rem 0.75rem 0.5rem 2.1rem;
      color: var(--text-white);
      font-size: 0.8125rem;
      font-family: inherit;
      outline: none;
      transition: all 0.15s ease;
    }

    .sidebar-search-input:focus {
      border-color: var(--border-strong);
      background: var(--bg-surface-elevated);
      box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.06);
    }

    .sidebar-search-icon {
      position: absolute;
      left: 0.7rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-dim);
      pointer-events: none;
    }

    .sidebar-group {
      margin-bottom: 2rem;
    }

    .sidebar-heading {
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 0.65rem;
      padding-left: 0.85rem;
    }

    .sidebar-nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .sidebar-nav-item {
      position: relative;
    }

    .sidebar-nav-link {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.95rem;
      border-radius: 0.55rem;
      color: var(--text-sub);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      transition: all 0.12s ease;
      user-select: none;
    }

    .sidebar-nav-link:hover {
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-white);
    }

    /* Active State (Image 1 Parity: pill background with white dot & white text) */
    .sidebar-nav-link.active {
      background: var(--bg-sidebar-pill);
      color: var(--text-white);
      font-weight: 700;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    }

    .nav-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--text-dim);
      flex-shrink: 0;
      transition: all 0.15s ease;
    }

    .sidebar-nav-link.active .nav-dot {
      background-color: #ffffff;
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
    }

    .sidebar-nav-link:hover .nav-dot {
      background-color: var(--text-sub);
    }

    /* ── RIGHT MAIN ARTICLE AREA ── */
    .main-content {
      flex: 1;
      min-width: 0;
      max-width: 880px;
    }

    /* Eyebrow & Hero Title */
    .content-eyebrow {
      font-size: 0.78125rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--text-muted);
      margin-bottom: 0.65rem;
      display: inline-block;
    }

    .hero-title {
      font-size: clamp(2.25rem, 4.5vw, 3.4rem);
      font-weight: 900;
      color: var(--text-white);
      letter-spacing: -0.03em;
      line-height: 1.12;
      margin-bottom: 1.25rem;
    }

    /* Pill badge below title: Cập nhật lần cuối: 2026 · discord.gg/pade */
    .meta-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid var(--border-subtle);
      border-radius: 9999px;
      padding: 0.4rem 1rem;
      font-size: 0.8125rem;
      color: var(--text-sub);
      margin-bottom: 2rem;
    }

    .meta-badge-icon {
      color: var(--text-muted);
      display: inline-flex;
    }

    .meta-badge-link {
      color: var(--text-white);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.15s ease;
    }

    .meta-badge-link:hover {
      text-decoration: underline;
      color: var(--accent-blue);
    }

    /* Divider */
    .section-divider {
      border: 0;
      border-top: 1px solid var(--border-subtle);
      margin: 2.25rem 0;
    }

    /* ── SECTION ITEM (Image 1 Parity) ── */
    .tos-section {
      scroll-margin-top: 5.5rem;
      position: relative;
    }

    .section-header-row {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    /* Number badge (01, 02, etc.) */
    .number-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      background: var(--bg-badge);
      border: 1px solid var(--border-subtle);
      border-radius: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      font-weight: 700;
      color: var(--text-muted);
      flex-shrink: 0;
    }

    .section-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--text-white);
      letter-spacing: -0.015em;
      line-height: 1.3;
    }

    .section-anchor-btn {
      opacity: 0;
      color: var(--text-dim);
      text-decoration: none;
      font-size: 1rem;
      margin-left: 0.35rem;
      transition: all 0.15s ease;
    }

    .tos-section:hover .section-anchor-btn {
      opacity: 1;
    }

    .section-anchor-btn:hover {
      color: var(--text-white);
    }

    .section-lead-text {
      font-size: 0.95rem;
      color: var(--text-sub);
      line-height: 1.7;
      margin-bottom: 1rem;
    }

    /* Bullet List (Exact bullet points from image) */
    .rules-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      margin: 0.85rem 0;
    }

    .rules-list-item {
      position: relative;
      padding-left: 1.25rem;
      font-size: 0.9375rem;
      color: var(--text-main);
      line-height: 1.65;
    }

    .rules-list-item::before {
      content: "•";
      position: absolute;
      left: 0;
      top: -0.05rem;
      color: var(--text-dim);
      font-size: 1.25rem;
      line-height: 1;
    }

    .rules-list-item strong {
      color: var(--text-white);
      font-weight: 700;
    }

    /* ── CALLOUT BOX (Exact match to Section 02 Amber Warning in Image 1) ── */
    .callout-box {
      background: var(--accent-amber-bg);
      border: 1px solid var(--accent-amber-border);
      border-left: 4px solid var(--accent-amber);
      border-radius: 0.65rem;
      padding: 0.95rem 1.25rem;
      margin: 1.15rem 0;
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .callout-icon {
      color: var(--accent-amber);
      flex-shrink: 0;
      margin-top: 0.15rem;
    }

    .callout-content {
      font-size: 0.9rem;
      font-weight: 600;
      color: #fef3c7;
      line-height: 1.55;
    }

    /* Red / Danger Callout */
    .callout-box.callout-danger {
      background: #1c0e0e;
      border: 1px solid rgba(239, 68, 68, 0.35);
      border-left: 4px solid var(--accent-red);
    }

    .callout-box.callout-danger .callout-icon {
      color: var(--accent-red);
    }

    .callout-box.callout-danger .callout-content {
      color: #fee2e2;
    }

    /* Blue / Info Callout */
    .callout-box.callout-info {
      background: #0d1624;
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-left: 4px solid var(--accent-blue);
    }

    .callout-box.callout-info .callout-icon {
      color: var(--accent-blue);
    }

    .callout-box.callout-info .callout-content {
      color: #e0f2fe;
    }

    /* Policy Card Grid (for Service-specific features) */
    .policy-card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1rem;
      margin: 1.25rem 0;
    }

    .policy-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 0.75rem;
      padding: 1.15rem;
      transition: all 0.2s ease;
    }

    .policy-card:hover {
      border-color: var(--border-strong);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }

    .policy-card-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-white);
      margin-bottom: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .policy-card-desc {
      font-size: 0.8125rem;
      color: var(--text-sub);
      line-height: 1.6;
    }

    /* ── FOOTER ── */
    .site-footer {
      border-top: 1px solid var(--border-subtle);
      background: #090a0d;
      padding: 3rem 1.5rem;
      color: var(--text-muted);
      font-size: 0.8125rem;
    }

    .footer-inner {
      max-width: 1260px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
    }

    .footer-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      list-style: none;
    }

    .footer-link {
      color: var(--text-sub);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .footer-link:hover {
      color: var(--text-white);
    }

    /* ── TOAST NOTIFICATION ── */
    .toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #1c1d26;
      border: 1px solid var(--border-strong);
      color: var(--text-white);
      padding: 0.75rem 1.25rem;
      border-radius: 0.55rem;
      font-size: 0.875rem;
      font-weight: 600;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
      z-index: 1000;
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* ── RESPONSIVE TWEAKS ── */
    @media (max-width: 900px) {
      .layout-wrapper {
        flex-direction: column;
        gap: 2rem;
        padding-top: 1.5rem;
      }

      .mobile-menu-btn {
        display: inline-flex;
      }

      .sidebar {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 82vw;
        max-width: 320px;
        height: 100vh;
        max-height: 100vh;
        background: #101117;
        z-index: 200;
        padding: 1.5rem;
        box-shadow: 10px 0 40px rgba(0, 0, 0, 0.7);
        border-right: 1px solid var(--border-subtle);
      }

      .sidebar.open {
        display: block;
      }

      .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(4px);
        z-index: 199;
      }

      .sidebar-backdrop.open {
        display: block;
      }

      .nav-tabs {
        display: none;
      }
    }
  </style>
</head>
<body>
  <div class="reading-progress" id="readingProgress"></div>
  <div class="ambient-mesh"></div>

  <!-- Top Navigation Header -->
  <header class="top-header">
    <div class="top-header-inner">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <button class="mobile-menu-btn" id="mobileMenuToggle" aria-label="Mở danh mục điều khoản">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          <span>Mục Lục</span>
        </button>

        <a href="/" class="brand-group">
          <div class="brand-avatar">
            <img src="/assets/pade-guild-icon.png" alt="Pade Store" onerror="this.onerror=null;this.src='/assets/favicon.png';" />
          </div>
          <span class="brand-name">Pade Store</span>
        </a>
      </div>

      <nav class="nav-tabs" aria-label="Subdomain Navigation">
        <a href="/tos" class="nav-tab-link active">Terms of Service</a>
        <a href="/rules" class="nav-tab-link">Server Rules</a>
        <a href="https://menu.sorae.tokyo" class="nav-tab-link">Bảng Giá Menu</a>
        <a href="https://payment.sorae.tokyo" class="nav-tab-link">Cổng Thanh Toán</a>
      </nav>

      <div class="header-actions">
