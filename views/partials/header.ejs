<!-- Minimalist Editorial Navigation & Mobile Floating Dock -->
<header class="header" id="header">
  <div class="header-nav-container">
    <nav class="nav-minimal-group" id="navMenu" aria-label="Main Navigation">
      <button type="button" class="nav-minimal-link <%= activePage === 'home' ? 'active' : '' %>" data-route="home" data-path="/" aria-label="Navigate to Home">
        <svg class="nav-icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 10 9-7 9 7v10a1.5 1.5 0 0 1-1.5 1.5H4.5A1.5 1.5 0 0 1 3 20z"/>
          <polyline points="9 21.5 9 12 15 12 15 21.5"/>
        </svg>
        <span>Home</span>
      </button>

      <button type="button" class="nav-minimal-link <%= activePage === 'intro' ? 'active' : '' %>" data-route="intro" data-path="/intro" aria-label="Navigate to Intro">
        <svg class="nav-icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span>Intro</span>
      </button>

      <button type="button" class="nav-minimal-link <%= activePage === 'skills' ? 'active' : '' %>" data-route="skills" data-path="/skills" aria-label="Navigate to Skills">
        <svg class="nav-icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="7 8 3 12 7 16"/>
          <polyline points="17 8 21 12 17 16"/>
          <line x1="14" y1="4" x2="10" y2="20"/>
        </svg>
        <span>Skills</span>
      </button>

      <button type="button" class="nav-minimal-link <%= activePage === 'contact' ? 'active' : '' %>" data-route="contact" data-path="/contact" aria-label="Navigate to Contact">
        <svg class="nav-icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="15" x="2" y="4.5" rx="2"/>
          <path d="m22 7.5-9 6-9-6"/>
        </svg>
        <span>Contact</span>
      </button>

      <!-- Ambient Music Player Equalizer Pill -->
      <button type="button" class="nav-music-pill" id="musicToggleBtn" title="Toggle background music: Crush (Volume 45%)" aria-label="Toggle background music">
        <div class="equalizer-bars" id="equalizerBars">
          <span class="bar bar-1"></span>
          <span class="bar bar-2"></span>
          <span class="bar bar-3"></span>
          <span class="bar bar-4"></span>
        </div>
        <span class="music-text">Crush ♪</span>
      </button>
    </nav>
  </div>
</header>

<!-- Background Audio Asset (Adaptive Multi-Codec: WebM Opus ~3.4MB for mobile 3G/4G, MP3 ~3.8MB universal fallback) -->
<audio id="bgAudio" loop preload="auto" data-src="/music/crush.mp3">
  <source src="/music/crush.webm" type="audio/webm">
  <source src="/music/crush.mp3" type="audio/mpeg">
</audio>
