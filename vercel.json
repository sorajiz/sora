    { "source": "/rules/(.*)", "destination": "/rules.html" },
    { "source": "/tos", "destination": "/tos.html" },
    { "source": "/tos/(.*)", "destination": "/tos.html" },
    { "source": "/tutorial", "destination": "/tutorial.html" },
    { "source": "/tutorial/(.*)", "destination": "/tutorial.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/menu/(.*)", "destination": "/menu.html" },
    { "source": "/api/menu", "destination": "/api/menu" },
    { "source": "/api/menu/(.*)", "destination": "/api/menu" },
    { "source": "/api/auth/(.*)", "destination": "/api/menu" },
    { "source": "/api/admin/(.*)", "destination": "/api/menu" },
    { "source": "/tickets/transcript", "destination": "/api/tickets/transcript" },
    { "source": "/tickets/transcript/(.*)", "destination": "/api/tickets/transcript" },
    { "source": "/t/:id/download/html", "destination": "/api/tickets/transcript?id=:id&action=download" },
    { "source": "/t/:id/download", "destination": "/api/tickets/transcript?id=:id&action=download" },
    { "source": "/t/:id/media/:assetId", "destination": "/api/tickets/transcript?id=:id&media=:assetId" },
    { "source": "/t/:id", "destination": "/api/tickets/transcript?id=:id" },
    { "source": "/hooks/sepay-payment", "destination": "/api/hooks/sepay-payment" },
    { "source": "/hooks/sepay-payment/(.*)", "destination": "/api/hooks/sepay-payment" },
    { "source": "/pay", "destination": "/pay.html" },
    { "source": "/pay/(.*)", "destination": "/pay.html" },
    { "source": "/payment", "destination": "/payment.html" },
    { "source": "/payment/(.*)", "destination": "/payment.html" },
    { "source": "/ORD:path*", "destination": "/pay.html" },
    { "source": "/ord:path*", "destination": "/pay.html" },
    { "source": "/SR:path*", "destination": "/pay.html" },
    { "source": "/sr:path*", "destination": "/pay.html" },
    { "source": "/:amount(\\d{3,9})/ORD:path*", "destination": "/pay.html" },
    { "source": "/:amount(\\d{3,9})/ord:path*", "destination": "/pay.html" },
    { "source": "/:amount(\\d{3,9})/SR:path*", "destination": "/pay.html" },
    { "source": "/:amount(\\d{3,9})/sr:path*", "destination": "/pay.html" },
