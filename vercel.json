{
  "version": 2,
  "name": "sora",
  "alias": [
    "sorastation.vercel.app"
  ],
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "discord.sorae.tokyo"
        }
      ],
      "destination": "/discord",
      "permanent": false
    },
    {
      "source": "/((?!assets|js|music|favicon|discord|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "discord.sorae.tokyo"
        }
      ],
      "destination": "/discord",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "timework.sorae.tokyo"
        }
      ],
      "destination": "/timework",
      "permanent": false
    },
    {
      "source": "/((?!assets|js|music|favicon|timework|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "timework.sorae.tokyo"
        }
      ],
      "destination": "/timework",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "timeworks.sorae.tokyo"
        }
      ],
      "destination": "/timework",
      "permanent": false
    },
    {
      "source": "/((?!assets|js|music|favicon|timework|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "timeworks.sorae.tokyo"
        }
      ],
      "destination": "/timework",
      "permanent": false
    },
    {
      "source": "/pay/:code([A-Za-z0-9_-]+)/:amount(\\d+)",
      "destination": "/pay?code=:code&amount=:amount",
      "permanent": false
    },
    {
      "source": "/payment/:code([A-Za-z0-9_-]+)/:amount(\\d+)",
      "destination": "/payment?code=:code&amount=:amount",
      "permanent": false
    },
    {
      "source": "/pay/:code([A-Za-z0-9_-]+)",
      "destination": "/pay?code=:code",
      "permanent": false
    },
    {
      "source": "/payment/:code([A-Za-z0-9_-]+)",
      "destination": "/payment?code=:code",
      "permanent": false
    },
    {
      "source": "/:code(ORD\\d+|SR\\d+)",
      "destination": "/pay?code=:code",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "payment.sorae.tokyo"
        }
      ],
      "destination": "/pay",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "pay.sorae.tokyo"
        }
      ],
      "destination": "/pay",
      "permanent": false
    },
    {
      "source": "/:code((?!pay$|payment$|api$)[A-Za-z0-9_-]+)/:amount(\\d+)",
      "has": [
        {
          "type": "host",
          "value": "payment.sorae.tokyo"
        }
      ],
      "destination": "/pay?code=:code&amount=:amount",
      "permanent": false
    },
    {
      "source": "/:code((?!pay$|payment$|api$)[A-Za-z0-9_-]+)/:amount(\\d+)",
      "has": [
        {
          "type": "host",
          "value": "pay.sorae.tokyo"
        }
      ],
      "destination": "/pay?code=:code&amount=:amount",
      "permanent": false
    },
    {
      "source": "/:code((?!pay$|payment$|api$)[A-Za-z0-9_-]+)",
      "has": [
        {
          "type": "host",
          "value": "payment.sorae.tokyo"
        }
      ],
      "destination": "/pay?code=:code",
      "permanent": false
    },
    {
      "source": "/:code((?!pay$|payment$|api$)[A-Za-z0-9_-]+)",
      "has": [
        {
          "type": "host",
          "value": "pay.sorae.tokyo"
        }
      ],
      "destination": "/pay?code=:code",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/pay", "destination": "/pay.html" },
    { "source": "/pay/(.*)", "destination": "/pay.html" },
    { "source": "/payment", "destination": "/payment.html" },
    { "source": "/payment/(.*)", "destination": "/payment.html" },
    { "source": "/:code(ORD\\d+|SR\\d+)", "destination": "/pay.html" },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "discord.sorae.tokyo"
        }
      ],
      "destination": "/discord.html"
    },
    {
      "source": "/((?!assets|js|music|favicon|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "discord.sorae.tokyo"
        }
      ],
      "destination": "/discord.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "timework.sorae.tokyo"
        }
      ],
      "destination": "/timework.html"
    },
    {
      "source": "/((?!assets|js|music|favicon|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "timework.sorae.tokyo"
        }
      ],
      "destination": "/timework.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "timeworks.sorae.tokyo"
        }
      ],
      "destination": "/timework.html"
    },
    {
      "source": "/((?!assets|js|music|favicon|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "timeworks.sorae.tokyo"
        }
      ],
      "destination": "/timework.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "pay.sorae.tokyo"
        }
      ],
      "destination": "/pay.html"
    },
    {
      "source": "/((?!assets|js|music|favicon|api|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "pay.sorae.tokyo"
        }
      ],
      "destination": "/pay.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "payment.sorae.tokyo"
        }
      ],
      "destination": "/pay.html"
    },
    {
      "source": "/((?!assets|js|music|favicon|api|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "payment.sorae.tokyo"
        }
      ],
      "destination": "/pay.html"
    },
    { "source": "/favicon.ico", "destination": "/assets/favicon.ico" },
    { "source": "/favicon.png", "destination": "/assets/favicon.png" },
    { "source": "/intro", "destination": "/intro.html" },
    { "source": "/skills", "destination": "/skills.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/discord", "destination": "/discord.html" },
    { "source": "/timework", "destination": "/timework.html" },
    { "source": "/timeworks", "destination": "/timework.html" },
    { "source": "/((?!assets|js|music|favicon|api|pay|payment|ORD|SR|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://va.vercel-scripts.com; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/(assets|js|music)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.html|/|/intro|/skills|/contact|/discord)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
