# ==============================================================================
# SORA ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env for local overrides. Never commit actual secret keys to Git.
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Enforce HTTPS redirect and strict HSTS headers (production only)
FORCE_HTTPS=false

# Discord Bot Backend URL (Tunnel / ngrok / Cloudflare Tunnel / local endpoint for Ticket Transcripts)
# Example: https://bot-tunnel.sorae.tokyo or https://your-id.ngrok-free.app or http://127.0.0.1:3001
BOT_BACKEND_URL=

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Discord OAuth2 Configuration (Pade Store Menu)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_OAUTH_REDIRECT_URI=https://menu.sorae.tokyo/api/auth/discord/callback
SESSION_SECRET=generate_a_random_32_byte_secret_here

# Pade Store Permissions
PADE_OWNER_DISCORD_ID=386528085681635328
OWNER_DISCORD_USER_ID=386528085681635328
ADMIN_DISCORD_USER_IDS=

